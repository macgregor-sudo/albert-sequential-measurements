module
public import Interfaces.WordsAndCertificates
public import Mathlib.Algebra.Star.Free
-- The pinned upstream module has no public star/mk simp lemma. Its foundational
-- implementation is imported to prove that elementary quotient-map identity.
public import Mathlib.Algebra.Star.RingQuot
import all Mathlib.Algebra.Star.RingQuot
import all Mathlib.Algebra.RingQuot
public import Mathlib.Algebra.MonoidAlgebra.Module

/-! An actual associative real star algebra generated by self-adjoint
idempotents. It is independent of a moment function or a matching hypothesis. -/
@[expose] public section
noncomputable section
namespace AlbertSequential

abbrev ProjectionFreeAlgebra (n : ℕ) := FreeAlgebra ℝ (Fin n)

/-- Only the algebraic generator relations; no state or positivity premise. -/
inductive ProjectionIdempotence (n : ℕ) :
    ProjectionFreeAlgebra n → ProjectionFreeAlgebra n → Prop
  | generator (i : Fin n) :
      ProjectionIdempotence n (FreeAlgebra.ι ℝ i * FreeAlgebra.ι ℝ i)
        (FreeAlgebra.ι ℝ i)

theorem projectionIdempotence_star {n : ℕ} (x y : ProjectionFreeAlgebra n)
    (h : ProjectionIdempotence n x y) :
    ProjectionIdempotence n (star x) (star y) := by
  cases h with
  | generator i => simpa using ProjectionIdempotence.generator (n := n) i

abbrev UniversalProjectionAlgebra (n : ℕ) := RingQuot (ProjectionIdempotence n)

instance universalProjectionStarRing (n : ℕ) :
    StarRing (UniversalProjectionAlgebra n) :=
  RingQuot.starRing (ProjectionIdempotence n) projectionIdempotence_star

def projectionQuotient (n : ℕ) :
    ProjectionFreeAlgebra n →ₐ[ℝ] UniversalProjectionAlgebra n :=
  RingQuot.mkAlgHom ℝ (ProjectionIdempotence n)

theorem projectionQuotient_surjective (n : ℕ) :
    Function.Surjective (projectionQuotient n) :=
  RingQuot.mkAlgHom_surjective ℝ (ProjectionIdempotence n)

theorem projectionQuotient_star {n : ℕ} (x : ProjectionFreeAlgebra n) :
    star (projectionQuotient n x) = projectionQuotient n (star x) := by
  simp only [projectionQuotient, RingQuot.mkAlgHom, RingQuot.mkRingHom]
  rfl

theorem projectionFreeAlgebra_star_smul {n : ℕ} (r : ℝ) (x : ProjectionFreeAlgebra n) :
    star (r • x) = r • star x := by
  rw [Algebra.smul_def, star_mul, FreeAlgebra.star_algebraMap, Algebra.smul_def]
  exact (Algebra.commutes r (star x)).symm

instance universalProjectionStarModule (n : ℕ) :
    StarModule ℝ (UniversalProjectionAlgebra n) where
  star_smul r x := by
    obtain ⟨y, rfl⟩ := projectionQuotient_surjective n x
    rw [← map_smul, projectionQuotient_star, projectionFreeAlgebra_star_smul, map_smul]
    simp only [star_trivial, projectionQuotient_star]

def universalProjection {n : ℕ} (i : Fin n) : UniversalProjectionAlgebra n :=
  projectionQuotient n (FreeAlgebra.ι ℝ i)

theorem universalProjection_idempotent {n : ℕ} (i : Fin n) :
    universalProjection i * universalProjection i = universalProjection i := by
  unfold universalProjection
  rw [← map_mul]
  exact RingQuot.mkAlgHom_rel ℝ (ProjectionIdempotence.generator i)

theorem universalProjection_selfAdjoint {n : ℕ} (i : Fin n) :
    star (universalProjection i) = universalProjection i := by
  simp only [universalProjection, projectionQuotient_star, FreeAlgebra.star_ι]

/-- A scalar realization is a consistency control for the presentation. -/
def universalProjectionScalarModel (n : ℕ) : UniversalProjectionAlgebra n →ₐ[ℝ] ℝ :=
  RingQuot.liftAlgHom ℝ ⟨FreeAlgebra.lift ℝ (fun _ : Fin n => (1 : ℝ)), by
    intro x y h
    cases h with
    | generator i => simp⟩

theorem universalProjectionAlgebra_nontrivial (n : ℕ) :
    (0 : UniversalProjectionAlgebra n) ≠ 1 := by
  intro h
  have bad := congrArg (universalProjectionScalarModel n) h
  simp at bad

end AlbertSequential
