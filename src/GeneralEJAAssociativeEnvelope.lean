module

public import UnitalJordanProduct
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.Star.Module
public import Mathlib.Basic.Real.Star
public import Mathlib.Data.List.OfFn
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.Tactic.NormNum

/-! The unital associative algebra generated by a finite-dimensional Jordan
image is finite-dimensional. A long word can be shortened using the
anticommutator identity and a repeated basis generator. -/

set_option autoImplicit false
@[expose] public section
noncomputable section

namespace AlbertSequential.UnitalJordanProduct

open Module
open scoped BigOperators List

variable {E A : Type*} [AddCommGroup E] [Module ℝ E] [Ring A] [Algebra ℝ A]

private def evalWord {ι : Type*} (g : ι → A) (w : List ι) : A := (w.map g).prod

omit [Algebra ℝ A] in
private theorem evalWord_append {ι : Type*} (g : ι → A) (u v : List ι) :
    evalWord g (u ++ v) = evalWord g u * evalWord g v := by
  simp [evalWord, List.prod_append]

private theorem mul_mem_wordSpan {ι : Type*} (g : ι → A) {x y : A}
    (hx : x ∈ Submodule.span ℝ (Set.range (evalWord g)))
    (hy : y ∈ Submodule.span ℝ (Set.range (evalWord g))) :
    x * y ∈ Submodule.span ℝ (Set.range (evalWord g)) := by
  refine Submodule.span_induction₂
    (p := fun a b _ _ => a * b ∈ Submodule.span ℝ (Set.range (evalWord g)))
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ hx hy
  · rintro _ _ ⟨u, rfl⟩ ⟨v, rfl⟩
    exact Submodule.subset_span ⟨u ++ v, evalWord_append g u v⟩
  · intros; simp
  · intros; simp
  · intro a b c _ _ _ ha hb
    rw [add_mul]
    exact Submodule.add_mem _ ha hb
  · intro a b c _ _ _ hb hc
    rw [mul_add]
    exact Submodule.add_mem _ hb hc
  · intro r a b _ _ h
    rw [Algebra.smul_mul_assoc]
    exact Submodule.smul_mem _ r h
  · intro r a b _ _ h
    rw [Algebra.mul_smul_comm]
    exact Submodule.smul_mem _ r h

private theorem sandwich_linearImage_mem {d : ℕ} (b : Basis (Fin d) ℝ E)
    (f : E →ₗ[ℝ] A) (L R : A) (x : E) (S : Submodule ℝ A)
    (hletters : ∀ k, L * f (b k) * R ∈ S) : L * f x * R ∈ S := by
  have hsum : L * f x * R = ∑ k, b.repr x k • (L * f (b k) * R) := by
    conv_lhs => rw [← b.sum_repr x]
    simp only [map_sum, map_smul, Finset.mul_sum, Finset.sum_mul,
      Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
  rw [hsum]
  exact S.sum_mem fun k _ => S.smul_mem (b.repr x k) (hletters k)

private theorem evalWord_perm_mem {d : ℕ} (P : UnitalJordanProduct E)
    (b : Basis (Fin d) ℝ E) (f : E →ₗ[ℝ] A)
    (hmul : ∀ x y, f (P.product x y) = (1 / 2 : ℝ) • (f x * f y + f y * f x))
    (S : Submodule ℝ A) {n : ℕ}
    (hshort : ∀ w : List (Fin d), w.length < n → evalWord (f ∘ b) w ∈ S)
    {u v : List (Fin d)} (hperm : u.Perm v) (pre : List (Fin d))
    (hlen : (pre ++ u).length = n) :
    evalWord (f ∘ b) (pre ++ u) ∈ S ↔ evalWord (f ∘ b) (pre ++ v) ∈ S := by
  induction hperm generalizing pre with
  | nil => rfl
  | cons i _ ih =>
    simpa only [List.append_assoc, List.singleton_append] using
      ih (pre ++ [i]) (by simpa only [List.append_assoc, List.singleton_append] using hlen)
  | swap i j w =>
    have hprod : f (b j) * f (b i) + f (b i) * f (b j) =
        (2 : ℝ) • f (P.product (b j) (b i)) := by
      rw [hmul, smul_smul]
      norm_num
    have hterms : evalWord (f ∘ b) (pre ++ j :: i :: w) +
        evalWord (f ∘ b) (pre ++ i :: j :: w) ∈ S := by
      have h : evalWord (f ∘ b) pre * f (P.product (b j) (b i)) * evalWord (f ∘ b) w ∈ S := by
        apply sandwich_linearImage_mem b f
        intro k
        have hk := hshort (pre ++ k :: w) (by simp at hlen ⊢; omega)
        simpa [evalWord_append, evalWord, mul_assoc] using hk
      have heq : evalWord (f ∘ b) (pre ++ j :: i :: w) +
          evalWord (f ∘ b) (pre ++ i :: j :: w) =
          evalWord (f ∘ b) pre * (f (b j) * f (b i) + f (b i) * f (b j)) *
            evalWord (f ∘ b) w := by
        simp [evalWord, mul_add, add_mul, mul_assoc]
      rw [heq, hprod, Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
      exact S.smul_mem _ h
    constructor
    · intro hu
      simpa using S.sub_mem hterms hu
    · intro hv
      simpa using S.sub_mem hterms hv
  | trans huv hvw ihuv ihvw =>
    exact (ihuv pre hlen).trans (ihvw pre (by simpa only [List.length_append,
      ← huv.length_eq] using hlen))

private theorem exists_perm_repeated_pair {ι : Type*} {w : List ι} (h : ¬ w.Nodup) :
    ∃ i v, w.Perm (i :: i :: v) := by
  induction w with
  | nil => exact (h List.nodup_nil).elim
  | cons i w ih =>
    classical
    by_cases hi : i ∈ w
    · obtain ⟨u, v, rfl, _⟩ := List.eq_append_cons_of_mem hi
      exact ⟨i, u ++ v, List.perm_middle.cons i⟩
    · have hw : ¬ w.Nodup := fun hn => h (List.nodup_cons.mpr ⟨hi, hn⟩)
      obtain ⟨j, v, hp⟩ := ih hw
      exact ⟨j, i :: v, (hp.cons i).trans (List.Perm.swap j i (j :: v) |>.trans
        ((List.Perm.swap j i v).cons j))⟩

private def boundedWord {d : ℕ} (g : Fin d → A) (w : Σ k : Fin (d + 1), Fin k.val → Fin d) : A :=
  evalWord g (List.ofFn w.2)

private theorem evalWord_mem_boundedSpan {d : ℕ} (P : UnitalJordanProduct E)
    (b : Basis (Fin d) ℝ E) (f : E →ₗ[ℝ] A)
    (hmul : ∀ x y, f (P.product x y) = (1 / 2 : ℝ) • (f x * f y + f y * f x))
    (w : List (Fin d)) : evalWord (f ∘ b) w ∈ Submodule.span ℝ (Set.range (boundedWord (f ∘ b))) := by
  classical
  let S := Submodule.span ℝ (Set.range (boundedWord (f ∘ b)))
  suffices h : ∀ n (v : List (Fin d)), v.length = n → evalWord (f ∘ b) v ∈ S from
    h w.length w rfl
  intro n
  induction n using Nat.strong_induction_on with
  | ind n ih =>
    intro w hn
    by_cases hle : n ≤ d
    · apply Submodule.subset_span
      refine ⟨⟨⟨w.length, by omega⟩, w.get⟩, ?_⟩
      rw [boundedWord, List.ofFn_get]
    · have hshort (v : List (Fin d)) (hv : v.length < n) : evalWord (f ∘ b) v ∈ S :=
        ih v.length hv v rfl
      have hdup : ¬ w.Nodup := fun hd => hle (by simpa [hn] using hd.length_le_card)
      obtain ⟨i, v, hp⟩ := exists_perm_repeated_pair hdup
      have hv : n = v.length + 2 := by simpa only [hn, List.length_cons] using hp.length_eq
      apply (evalWord_perm_mem P b f hmul S hshort hp [] hn).mpr
      have hsq : f (P.product (b i) (b i)) = f (b i) * f (b i) := by
        rw [hmul, ← two_smul ℝ, smul_smul]
        norm_num
      have hmem : (1 : A) * f (P.product (b i) (b i)) * evalWord (f ∘ b) v ∈ S := by
        apply sandwich_linearImage_mem b f
        intro k
        simpa [evalWord] using hshort (k :: v) (by simp; omega)
      simpa [evalWord, hsq, mul_assoc] using hmem

variable (f : E →ₗ[ℝ] A)

/-- The unital associative algebra generated by the real Jordan image. -/
def associativeEnvelope : Subalgebra ℝ A := Algebra.adjoin ℝ (Set.range f)

theorem image_mem_associativeEnvelope (x : E) : f x ∈ associativeEnvelope f :=
  Algebra.subset_adjoin ⟨x, rfl⟩

/-- The envelope of a self-adjoint image is closed under adjoints. -/
theorem star_mem_associativeEnvelope [StarRing A] [StarModule ℝ A]
    (hself : ∀ x, star (f x) = f x) {a : A} (ha : a ∈ associativeEnvelope f) :
    star a ∈ associativeEnvelope f := by
  refine Algebra.adjoin_induction (p := fun x _ => star x ∈ associativeEnvelope f)
    ?_ ?_ ?_ ?_ ha
  · rintro _ ⟨x, rfl⟩
    rw [hself x]
    exact image_mem_associativeEnvelope f x
  · intro r
    rw [Algebra.algebraMap_eq_smul_one, star_smul, star_trivial, star_one]
    exact (associativeEnvelope f).smul_mem (associativeEnvelope f).one_mem r
  · intro x y _ _ hₓ hᵧ
    rw [star_add]
    exact (associativeEnvelope f).add_mem hₓ hᵧ
  · intro x y _ _ hₓ hᵧ
    rw [star_mul]
    exact (associativeEnvelope f).mul_mem hᵧ hₓ

private def wordSpanAlgebra {ι : Type*} (g : ι → A) : Subalgebra ℝ A where
  carrier := Submodule.span ℝ (Set.range (evalWord g))
  mul_mem' := mul_mem_wordSpan g
  add_mem' := Submodule.add_mem _
  algebraMap_mem' r := by
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨[], rfl⟩)

variable [FiniteDimensional ℝ E]

private theorem associativeEnvelope_eq_wordSpanAlgebra :
    associativeEnvelope f = wordSpanAlgebra (f ∘ Module.finBasis ℝ E) := by
  let b := Module.finBasis ℝ E
  apply le_antisymm
  · refine Algebra.adjoin_le ?_
    rintro _ ⟨x, rfl⟩
    change f x ∈ Submodule.span ℝ (Set.range (evalWord (f ∘ b)))
    have h := sandwich_linearImage_mem b f 1 1 x
      (Submodule.span ℝ (Set.range (evalWord (f ∘ b)))) (fun i => by
      simpa using (Submodule.subset_span ⟨[i], by simp [evalWord]⟩ :
        f (b i) ∈ Submodule.span ℝ (Set.range (evalWord (f ∘ b)))))
    simpa using h
  · change Submodule.span ℝ (Set.range (evalWord (f ∘ b))) ≤ (associativeEnvelope f).toSubmodule
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨w, rfl⟩
    induction w with
    | nil => exact (associativeEnvelope f).one_mem
    | cons i w ih => exact (associativeEnvelope f).mul_mem (image_mem_associativeEnvelope f (b i)) ih

/-- The associative envelope of the Jordan image is finite-dimensional, even
when the ambient associative algebra is infinite-dimensional. -/
theorem finiteDimensional_associativeEnvelope (P : UnitalJordanProduct E)
    (hmul : ∀ x y, f (P.product x y) = (1 / 2 : ℝ) • (f x * f y + f y * f x)) :
    FiniteDimensional ℝ (associativeEnvelope f) := by
  classical
  let b := Module.finBasis ℝ E
  have heq : (associativeEnvelope f).toSubmodule =
      Submodule.span ℝ (Set.range (boundedWord (f ∘ b))) := by
    rw [associativeEnvelope_eq_wordSpanAlgebra]
    change Submodule.span ℝ (Set.range (evalWord (f ∘ b))) = _
    apply le_antisymm
    · refine Submodule.span_le.mpr ?_
      rintro _ ⟨w, rfl⟩
      exact evalWord_mem_boundedSpan P b f hmul w
    · refine Submodule.span_le.mpr ?_
      rintro _ ⟨w, rfl⟩
      exact Submodule.subset_span ⟨List.ofFn w.2, rfl⟩
  change FiniteDimensional ℝ (associativeEnvelope f).toSubmodule
  rw [heq]
  exact FiniteDimensional.span_of_finite ℝ (Set.finite_range _)

end AlbertSequential.UnitalJordanProduct
