public import NativeReflectionOrbit

/-! # lem:cer:h5:refl(a), proved: `reflectionClassConsistency : ReflectionClassConsistency`

Paper (companion `app:cert:h5`, proof of lem:cer:h5:refl(a)): if `t'u' = tu` or `t'u' = (tu)⁻¹` for reflections
of `G`, then `ς(t) ∘ ς(u) = ς(t') ∘ ς(u')`.

Same statement, different route for the group theory: no Cayley tree and no imported axis
theorem (`SerreAxisProposition` is not used).  Instead (`Axis.lean`, `AxisLine.lean`) a direct
argument on reduced words: after conjugating `h = tu` to a cyclically reduced `k`, the elements of
least displacement `|g⁻¹kg|` are the partial products `P(n)` of the periodic word `k^∞`; every
reflection inverting `k` acts on them as `P(m) ↦ P(c - m)`; the centres `c` form a progression
`b + δℤ`; so `t, u, t', u'` are the reflections of centres `b + nδ` of the infinite dihedral
group generated by `α = P(b)`, `β = P(b + δ)`, with `n_t - n_u = n_{t'} - n_{u'}`.

Albert side: same route as the paper.  By prop:three (`complexTripleContract_holds`) the atoms
of `ς(α)`, `ς(β)` lie in a complex window `W ≅ H₃(ℂ)`; `ς` of the reflection of centre
`b + nδ` is represented in `W` by the matrix `X^n A` (`X = BA`, `A, B` the matrices of `ς(α)`,
`ς(β)`, `A² = B² = 1`); so `ς(t) ∘ ς(u)` is represented by `(X^{n_t - n_u} + X^{n_u - n_t})/2`.

Headlines: `reflectionClassConsistency`, `horizonFive_of_seven`. -/

set_option autoImplicit false
@[expose] public section
noncomputable section
namespace AlbertSequential.HorizonFive

open AlbertSequential AlbertSequential.NativeAnalysis

/-! ## Native facts: `ρ` is an action by automorphisms and `ρ(t) = U_{ς(t)}` -/

theorem nativeRho_eq_aut (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) (w : List Test)
    (y : Albert) : nativeRho p w y = (nativeReflectionWordAutomorphism p hp w).linearEquiv y := by
  induction w with
  | nil => rfl
  | cons a w ih =>
    show quadraticMap (nativeSymmetry p a) (nativeRho p w y) = _
    rw [ih]
    simp only [nativeReflectionWordAutomorphism, nativeAutomorphismComposition_apply,
      atomReflectionAutomorphism_apply]
    rfl

theorem nativeRho_singleton (p : Test → Albert) (i : Test) (y : Albert) :
    nativeRho p [i] y = quadraticMap (nativeSymmetry p i) y := rfl

theorem nativeRho_reverse_right (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) (w : List Test)
    (y : Albert) : nativeRho p w (nativeRho p w.reverse y) = y := by
  rw [nativeRho_eq_aut p hp, nativeRho_eq_aut p hp, nativeReflectionWord_reverse_right]

/-- (eq:cer:h5:cov): `ρ(t) = U_{ς(t)}`. -/
theorem nativeRho_word (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) (t : Refl) (y : Albert) :
    nativeRho p t.word y = quadraticMap (varsigma p t) y := by
  rw [Refl.word, nativeRho_append, nativeRho_append, varsigma_eq, nativeRho_singleton,
    nativeRho_eq_aut p hp t.v, nativeRho_eq_aut p hp t.v, nativeAutomorphism_quadraticMap,
    ← nativeRho_eq_aut p hp t.v (nativeRho p t.v.reverse y), nativeRho_reverse_right p hp]

/-- `ρ` factors through `G`. -/
theorem nativeRho_reduce (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) (l : List Test)
    (y : Albert) : nativeRho p (reduceRW l).1 y = nativeRho p l y := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    show nativeRho p (flipWord a (reduceRW l)).1 y =
      quadraticMap (nativeSymmetry p a) (nativeRho p l y)
    rw [← ih]
    generalize reduceRW l = g
    unfold flipWord
    split
    · rename_i h
      obtain ⟨m, hm⟩ := g
      cases m with
      | nil => simp at h
      | cons b m =>
        simp only [List.head?_cons, Option.some.injEq] at h
        subst h
        show nativeRho p m y = quadraticMap (nativeSymmetry p b)
          (quadraticMap (nativeSymmetry p b) (nativeRho p m y))
        rw [quadraticMap_sym_invol p (fun k => (hp k).1)]
    · rfl

theorem nativeRho_congr (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) {l m : List Test}
    (h : groupElt l = groupElt m) (y : Albert) : nativeRho p l y = nativeRho p m y := by
  rw [← nativeRho_reduce p hp l, ← nativeRho_reduce p hp m, reduceRW_eq_of_groupElt_eq h]

theorem Refl.ext_of_word {t t' : Refl} (h : t.word = t'.word) : t = t' := by
  obtain ⟨v, i⟩ := t
  obtain ⟨v', i'⟩ := t'
  have hl : v.length = v'.length := by
    have := congrArg List.length h
    simp only [Refl.word, List.length_append, List.length_singleton, List.length_reverse] at this
    omega
  simp only [Refl.word, List.append_assoc] at h
  obtain ⟨h1, h2⟩ := List.append_inj h hl
  subst h1
  have : i = i' := by simpa using congrArg List.head? h2
  rw [this]

/-- `ς` depends only on the group element (the paper's well-definedness of `ς`). -/
theorem varsigma_congr (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) {t t' : Refl}
    (h : groupElt t.word = groupElt t'.word) : varsigma p t = varsigma p t' := by
  obtain ⟨t1, hr1, hg1, -, hς1⟩ := exists_canon t
  obtain ⟨t2, hr2, hg2, -, hς2⟩ := exists_canon t'
  have e : t1.word = t2.word := by
    have e3 : reduceRW t1.word = reduceRW t2.word :=
      reduceRW_eq_of_groupElt_eq (by rw [hg1, hg2, h])
    rw [reduceRW_of_reduced _ hr1, reduceRW_of_reduced _ hr2] at e3
    exact congrArg Subtype.val e3
  rw [← hς1 p hp, ← hς2 p hp, Refl.ext_of_word e]

theorem varsigma_atom (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) (t : Refl) :
    IsAtom (nativeRho p t.v (p t.i)) ∧
      varsigma p t = (2 : ℝ) • nativeRho p t.v (p t.i) - albertUnit := by
  refine ⟨?_, ?_⟩
  · rw [nativeRho_eq_aut p hp]; exact nativeAutomorphism_atom _ _ (hp _)
  · rw [varsigma_eq, nativeRho_eq_aut p hp, nativeRho_eq_aut p hp]
    simp only [nativeSymmetry, map_sub, map_smul,
      (nativeReflectionWordAutomorphism p hp t.v).preserves_unit]

theorem varsigma_sq (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) (t : Refl) :
    jordanMul (varsigma p t) (varsigma p t) = albertUnit := by
  have hp' : ∀ k, jordanMul (p k) (p k) = p k := fun k => (hp k).1
  rw [varsigma_eq, ← nativeRho_jordanMul p hp, nativeSymmetry_sq p hp', nativeRho_unit p hp']

/-! ## Window representatives -/

/-- `x` is represented in the window `W` by the matrix `M`. -/
def Rep (W : ComplexWindow) (x : Albert) (M : ComplexMatrix3) : Prop :=
  ∃ Z : Hermitian3, (Z : ComplexMatrix3) = M ∧ W.embedding Z = x

theorem rep_unique {W : ComplexWindow} {x y : Albert} {M : ComplexMatrix3} (hx : Rep W x M)
    (hy : Rep W y M) : x = y := by
  obtain ⟨Z, h1, h2⟩ := hx
  obtain ⟨Z', h3, h4⟩ := hy
  have : Z = Z' := Subtype.ext (h1.trans h3.symm)
  rw [← h2, ← h4, this]

theorem rep_mul {W : ComplexWindow} {x y : Albert} {M N : ComplexMatrix3} (hx : Rep W x M)
    (hy : Rep W y N) : Rep W (jordanMul x y) ((1 / 2 : ℝ) • (M * N + N * M)) := by
  obtain ⟨Z, rfl, rfl⟩ := hx
  obtain ⟨Z', rfl, rfl⟩ := hy
  obtain ⟨Z'', hZ⟩ := W.product_closed Z Z'
  exact ⟨Z'', hZ, W.preserves_product Z Z' Z'' hZ⟩

theorem rep_U {W : ComplexWindow} (A : Hermitian3) {y : Albert} {N : ComplexMatrix3}
    (hy : Rep W y N) :
    Rep W (quadraticMap (W.embedding A) y) ((A : ComplexMatrix3) * N * A) := by
  obtain ⟨Z, rfl, rfl⟩ := hy
  obtain ⟨Z', h1, h2⟩ := window_eval W (fun b : Bool => if b then Z else A)
    (JPoly.U (.var false) (.var true))
  refine ⟨Z', ?_, ?_⟩
  · rw [h1, JTarget.eval_U, specialTarget_Uop]
    rfl
  · rw [h2, JTarget.eval_U, albertTarget_Uop]
    rfl

/-! ## Two involutions in a group -/

theorem pow_reflect {G : Type*} [Group G] {a x : G} (h1 : a * x⁻¹ = x * a) (n : ℕ) :
    a * (x ^ n)⁻¹ = x ^ n * a := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, mul_inv_rev, ← mul_assoc, h1, mul_assoc, ih, ← mul_assoc, ← pow_succ', pow_succ]

theorem conj_pow_reflect {G : Type*} [Group G] {a x : G} (ha : a * a = 1)
    (h1 : a * x⁻¹ = x * a) (n : ℕ) : a * x ^ n * a = (x ^ n)⁻¹ := by
  have e := pow_reflect h1 n
  calc a * x ^ n * a = a * (x ^ n * a) := mul_assoc _ _ _
    _ = a * (a * (x ^ n)⁻¹) := by rw [e]
    _ = (x ^ n)⁻¹ := by rw [← mul_assoc, ha, one_mul]

theorem pow_mul_inv_eq {G : Type*} [Group G] (x : G) {n1 n2 m1 m2 : ℕ} (h : n1 + m2 = m1 + n2) :
    x ^ n1 * (x ^ n2)⁻¹ = x ^ m1 * (x ^ m2)⁻¹ := by
  simp only [← zpow_natCast, ← zpow_neg, ← zpow_add]
  congr 1
  omega

/-! ## Words of the dihedral group -/

/-- `l^n` as a word. -/
def lpow (l : List Test) : ℕ → List Test
  | 0 => []
  | n + 1 => l ++ lpow l n

theorem lpow_act {a : ℤ → Test} {δ : ℕ} (T : List Test)
    (hT : ∀ m, groupElt T * groupElt (seqP a m) = groupElt (seqP a (m + δ))) (j : ℕ) (m : ℤ) :
    groupElt (lpow T j) * groupElt (seqP a m) = groupElt (seqP a (m + j * δ)) := by
  induction j with
  | zero => simp [lpow, groupElt_nil]
  | succ j ih =>
    rw [lpow, groupElt_append, mul_assoc, ih, hT]
    congr 2
    push_cast; ring

theorem lpow_rev_act {a : ℤ → Test} {δ : ℕ} (T : List Test)
    (hT : ∀ m, groupElt T * groupElt (seqP a m) = groupElt (seqP a (m + δ))) (j : ℕ) (m : ℤ) :
    groupElt (lpow T j).reverse * groupElt (seqP a m) = groupElt (seqP a (m - j * δ)) := by
  have := lpow_act T hT j (m - j * δ)
  rw [sub_add_cancel] at this
  rw [← this, groupElt_reverse_mul_cancel]

theorem nativeRho_lpow (p : Test → Albert) (T : List Test) (j : ℕ) (y : Albert) :
    nativeRho p (lpow T (j + 1)) y = nativeRho p T (nativeRho p (lpow T j) y) := by
  rw [lpow, nativeRho_append]

/-! ## The cyclically reduced case -/

theorem good_of_pair (t u : Refl) (K : List Test)
    (h : groupElt (t.word ++ u.word) = groupElt K) :
    (groupElt t.word * groupElt t.word = 1 ∧ rlen t.word % 2 = 1 ∧
      groupElt t.word * groupElt K * groupElt t.word = groupElt K.reverse) ∧
    (groupElt u.word * groupElt u.word = 1 ∧ rlen u.word % 2 = 1 ∧
      groupElt u.word * groupElt K * groupElt u.word = groupElt K.reverse) := by
  have sq : ∀ s : Refl, groupElt s.word * groupElt s.word = 1 := by
    intro s
    have := groupElt_reverse_mul s.word
    rwa [Refl.word_reverse] at this
  have odd : ∀ s : Refl, rlen s.word % 2 = 1 := by
    intro s
    rw [rlen_parity, Refl.word_length]
    omega
  have hrev : groupElt K.reverse = groupElt u.word * groupElt t.word := by
    have := groupElt_reverse_eq h
    rw [← this, List.reverse_append, Refl.word_reverse, Refl.word_reverse, groupElt_append]
  rw [groupElt_append] at h
  refine ⟨⟨sq t, odd t, ?_⟩, ⟨sq u, odd u, ?_⟩⟩
  · rw [hrev, ← h, ← mul_assoc, sq t, one_mul]
  · rw [hrev, ← h, mul_assoc, mul_assoc, sq u, mul_one]

theorem main_cyc (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) (k : List Test)
    (hk : reducedB k = true) (hL : 2 ≤ k.length) (hcyc : k.head? ≠ k.getLast?)
    (t u t' u' : Refl) (h1 : groupElt (t.word ++ u.word) = groupElt k)
    (h2 : groupElt (t'.word ++ u'.word) = groupElt k) :
    jordanMul (varsigma p t) (varsigma p u) = jordanMul (varsigma p t') (varsigma p u') := by
  classical
  have hp' : ∀ k, jordanMul (p k) (p k) = p k := fun k => (hp k).1
  -- the line of `k`
  set a := cycSeq k with ha_def
  have ha : Alt a := cycSeq_alt k hk hL hcyc
  have hper : Per a k.length := cycSeq_per k
  have hK : seqP a k.length = k := seqP_cycSeq k
  have g1 := good_of_pair t u k h1
  have g2 := good_of_pair t' u' k h2
  rw [← hK] at g1 g2 h1 h2
  rw [groupElt_append] at h1 h2
  obtain ⟨b, δ, nt, nu, nt', nu', hb, hbδ, et, eu, et', eu', hn⟩ :=
    dihedral_coords k.length hL ha hper t.word u.word t'.word u'.word
      (by
        intro s hs
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
        rcases hs with rfl | rfl | rfl | rfl
        · exact g1.1
        · exact g1.2
        · exact g2.1
        · exact g2.2) h1 h2
  -- the two generating reflections
  obtain ⟨mα, hmα⟩ := act_odd ha hb
  obtain ⟨mβ, hmβ⟩ := act_odd ha hbδ
  obtain ⟨α, hα⟩ : ∃ α : Refl, groupElt α.word = groupElt (seqP a b) :=
    ⟨⟨seqP a mα, a mα⟩, (act_palin hb hmα).symm⟩
  obtain ⟨β, hβ⟩ : ∃ β : Refl, groupElt β.word = groupElt (seqP a (b + δ)) :=
    ⟨⟨seqP a mβ, a mβ⟩, (act_palin hbδ hmβ).symm⟩
  obtain ⟨T, hT, hρT⟩ : ∃ T : List Test,
      (∀ m, groupElt T * groupElt (seqP a m) = groupElt (seqP a (m + δ))) ∧
      ∀ y, nativeRho p T y = quadraticMap (varsigma p β) (quadraticMap (varsigma p α) y) := by
    refine ⟨β.word ++ α.word, fun m => ?_, fun y => ?_⟩
    · rw [groupElt_append, hα, hβ, mul_assoc, hb m, hbδ, show b + δ - (b - m) = m + δ by ring]
    · rw [nativeRho_append, nativeRho_word p hp, nativeRho_word p hp]
  -- presentations of the reflections of centre `b + nδ`
  have hev : ∀ (r : Refl) (c : ℤ), groupElt r.word = groupElt (seqP a c) → Act a c →
      ∀ j : ℕ, groupElt (Refl.word ⟨lpow T j ++ r.v, r.i⟩) =
        groupElt (seqP a (c + 2 * (j : ℤ) * δ)) := by
    intro r c hr hc j
    rw [word_split, groupElt_append, groupElt_append, show Refl.word ⟨r.v, r.i⟩ = r.word from rfl,
      hr]
    have e : groupElt (lpow T j).reverse =
        groupElt (lpow T j).reverse * groupElt (seqP a 0) := by
      rw [seqP_zero, groupElt_nil, mul_one]
    rw [e, mul_assoc, lpow_rev_act T hT, hc, lpow_act T hT]
    congr 2
    ring
  have hD : ∀ n : ℕ, ∃ d : Refl, groupElt d.word = groupElt (seqP a (b + n * δ)) ∧
      varsigma p d = nativeRho p (lpow T (n / 2))
        (if n % 2 = 0 then varsigma p α else varsigma p β) := by
    intro n
    by_cases h2n : n % 2 = 0
    · refine ⟨⟨lpow T (n / 2) ++ α.v, α.i⟩, ?_, ?_⟩
      · rw [hev α b hα hb (n / 2)]
        congr 2
        have : (n : ℤ) = 2 * ((n / 2 : ℕ) : ℤ) := by omega
        rw [this]
      · rw [varsigma_append, ite_eq_left h2n]
    · refine ⟨⟨lpow T (n / 2) ++ β.v, β.i⟩, ?_, ?_⟩
      · rw [hev β (b + δ) hβ hbδ (n / 2)]
        congr 2
        have : (n : ℤ) = 2 * ((n / 2 : ℕ) : ℤ) + 1 := by omega
        rw [this]; ring
      · rw [varsigma_append, ite_eq_right h2n]
  -- the window
  obtain ⟨hqα, hςα⟩ := varsigma_atom p hp α
  obtain ⟨hqβ, hςβ⟩ := varsigma_atom p hp β
  set qα := nativeRho p α.v (p α.i)
  set qβ := nativeRho p β.v (p β.i)
  obtain ⟨W, hW⟩ := complexTripleContract_holds.common_window ![qα, qβ, qβ]
    (fun i => by fin_cases i <;> simp [hqα, hqβ])
  obtain ⟨X1, hX1⟩ := hW 0
  obtain ⟨X2, hX2⟩ := hW 1
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at hX1 hX2
  have hidem : ∀ (X : Hermitian3) (q : Albert), W.embedding X = q → IsAtom q →
      (X : ComplexMatrix3) * X = X := by
    intro X q hX hq
    obtain ⟨Z, hZ⟩ := W.product_closed X X
    have h1 := W.preserves_product X X Z hZ
    rw [hX, hq.1, ← hX] at h1
    have h2 := W.injective h1
    rw [h2] at hZ
    have h3 : (1 / 2 : ℝ) • ((X : ComplexMatrix3) * X + X * X) = X * X := by
      rw [← two_smul ℝ ((X : ComplexMatrix3) * X), smul_smul]
      norm_num
    rw [← h3]
    exact hZ.symm
  have hsym : ∀ (X : Hermitian3), (X : ComplexMatrix3) * X = X →
      (((2 : ℝ) • X - 1 : Hermitian3) : ComplexMatrix3) * ((2 : ℝ) • X - 1 : Hermitian3) = 1 := by
    intro X hX
    show ((2 : ℝ) • (X : ComplexMatrix3) - 1) * ((2 : ℝ) • (X : ComplexMatrix3) - 1) = 1
    simp only [sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm, smul_smul, one_mul, mul_one, hX]
    module
  set A : Hermitian3 := (2 : ℝ) • X1 - 1 with hA_def
  set B : Hermitian3 := (2 : ℝ) • X2 - 1 with hB_def
  have hAA : (A : ComplexMatrix3) * A = 1 := hsym X1 (hidem X1 qα hX1 hqα)
  have hBB : (B : ComplexMatrix3) * B = 1 := hsym X2 (hidem X2 qβ hX2 hqβ)
  have hembA : W.embedding A = varsigma p α := by
    rw [hςα, hA_def, map_sub, map_smul, W.unit, hX1]
  have hembB : W.embedding B = varsigma p β := by
    rw [hςβ, hB_def, map_sub, map_smul, W.unit, hX2]
  -- matrix units
  let uA : (ComplexMatrix3)ˣ := ⟨A, A, hAA, hAA⟩
  let uB : (ComplexMatrix3)ˣ := ⟨B, B, hBB, hBB⟩
  have huA : uA * uA = 1 := Units.ext hAA
  have huB : uB * uB = 1 := Units.ext hBB
  have hiA : uA⁻¹ = uA := inv_eq_of_mul_eq_one_right huA
  have hiB : uB⁻¹ = uB := inv_eq_of_mul_eq_one_right huB
  let x : (ComplexMatrix3)ˣ := uB * uA
  have hx1 : uA * x⁻¹ = x * uA := by
    show uA * (uB * uA)⁻¹ = uB * uA * uA
    rw [mul_inv_rev, hiA, hiB, ← mul_assoc, huA, one_mul, mul_assoc, huA, mul_one]
  -- representatives
  have hrepT : ∀ (y : Albert) (N : ComplexMatrix3), Rep W y N →
      Rep W (nativeRho p T y) ((x : ComplexMatrix3) * N * ((x⁻¹ : (ComplexMatrix3)ˣ) : _)) := by
    intro y N hy
    have e : nativeRho p T y = quadraticMap (W.embedding B) (quadraticMap (W.embedding A) y) := by
      rw [hρT, hembA, hembB]
    rw [e]
    have := rep_U B (rep_U A hy)
    convert this using 1
    show (uB : ComplexMatrix3) * uA * N * ((uB * uA)⁻¹ : (ComplexMatrix3)ˣ) = _
    rw [mul_inv_rev, hiA, hiB, Units.val_mul]
    simp only [mul_assoc]
    rfl
  have hrepPow : ∀ (y : Albert) (N : ComplexMatrix3), Rep W y N → ∀ j : ℕ,
      Rep W (nativeRho p (lpow T j) y)
        (((x ^ j : (ComplexMatrix3)ˣ) : ComplexMatrix3) * N * (((x ^ j)⁻¹ : (ComplexMatrix3)ˣ) : _)) := by
    intro y N hy j
    induction j with
    | zero => simpa [lpow, nativeRho] using hy
    | succ j ih =>
      rw [nativeRho_lpow]
      have := hrepT _ _ ih
      convert this using 1
      simp only [pow_succ', mul_inv_rev, Units.val_mul, mul_assoc]
  have hxA : x * uA = uB := by
    show uB * uA * uA = uB
    rw [mul_assoc, huA, mul_one]
  have hrep : ∀ (s : Refl) (n : ℕ), groupElt s.word = groupElt (seqP a (b + n * δ)) →
      Rep W (varsigma p s) (((x ^ n * uA : (ComplexMatrix3)ˣ)) : ComplexMatrix3) := by
    intro s n hs
    obtain ⟨d, hd1, hd2⟩ := hD n
    rw [varsigma_congr p hp (hs.trans hd1.symm), hd2]
    by_cases h2n : n % 2 = 0
    · rw [ite_eq_left h2n]
      have := hrepPow (varsigma p α) _ ⟨A, rfl, hembA⟩ (n / 2)
      convert this using 1
      show _ = ((x ^ (n / 2) * uA * (x ^ (n / 2))⁻¹ : (ComplexMatrix3)ˣ) : ComplexMatrix3)
      congr 1
      rw [mul_assoc, pow_reflect hx1, ← mul_assoc, ← pow_add]
      congr 2
      omega
    · rw [ite_eq_right h2n]
      have := hrepPow (varsigma p β) _ ⟨B, rfl, hembB⟩ (n / 2)
      convert this using 1
      show _ = ((x ^ (n / 2) * uB * (x ^ (n / 2))⁻¹ : (ComplexMatrix3)ˣ) : ComplexMatrix3)
      congr 1
      rw [← hxA, mul_assoc, mul_assoc, pow_reflect hx1, ← mul_assoc, ← mul_assoc, ← pow_succ,
        ← pow_add]
      congr 2
      omega
  have hprod : ∀ n m : ℕ, (x ^ n * uA) * (x ^ m * uA) = x ^ n * (x ^ m)⁻¹ := by
    intro n m
    rw [mul_assoc, ← mul_assoc uA, conj_pow_reflect huA hx1]
  have r1 := rep_mul (hrep t nt et) (hrep u nu eu)
  have r2 := rep_mul (hrep t' nt' et') (hrep u' nu' eu')
  rw [← Units.val_mul, ← Units.val_mul, hprod, hprod] at r1 r2
  rw [pow_mul_inv_eq x (n1 := nt) (n2 := nu) (m1 := nt') (m2 := nu') (by omega),
    pow_mul_inv_eq x (n1 := nu) (n2 := nt) (m1 := nu') (m2 := nt') (by omega)] at r1
  exact rep_unique r1 r2

/-! ## The general case -/

theorem consistency_same (p : Test → Albert) (hp : ∀ i, IsAtom (p i)) (t u t' u' : Refl)
    (h : groupElt (t'.word ++ u'.word) = groupElt (t.word ++ u.word)) :
    jordanMul (varsigma p t) (varsigma p u) = jordanMul (varsigma p t') (varsigma p u') := by
  have sq : ∀ s : Refl, groupElt s.word * groupElt s.word = 1 := by
    intro s
    have := groupElt_reverse_mul s.word
    rwa [Refl.word_reverse] at this
  -- `tu = 1` implies `t = u`
  have triv : ∀ v w : Refl, groupElt (v.word ++ w.word) = 1 →
      jordanMul (varsigma p v) (varsigma p w) = albertUnit := by
    intro v w hvw
    have e : groupElt w.word = groupElt v.word := by
      rw [groupElt_append] at hvw
      calc groupElt w.word = groupElt v.word * (groupElt v.word * groupElt w.word) := by
            rw [← mul_assoc, sq v, one_mul]
        _ = groupElt v.word := by rw [hvw, mul_one]
    rw [varsigma_congr p hp e, varsigma_sq p hp]
  set hw := (reduceRW (t.word ++ u.word)).1 with hhw
  have hred : reducedB hw = true := (reduceRW _).2
  have hgw : groupElt hw = groupElt (t.word ++ u.word) := groupElt_reduceRW _
  by_cases h0 : hw = []
  · have e1 : groupElt (t.word ++ u.word) = 1 := by rw [← hgw, h0, groupElt_nil]
    rw [triv t u e1, triv t' u' (h.trans e1)]
  · obtain ⟨g, k, hgk, hk, hc⟩ := cyc_reduce hw.length hw le_rfl hred
    have hk0 : k ≠ [] := by
      intro hk0
      rw [hk0, List.append_nil] at hgk
      apply h0
      rw [hgk]
      cases g with
      | nil => rfl
      | cons x g =>
        exfalso
        have hr : reducedB ((x :: g) ++ (x :: g).reverse) = true := hgk ▸ hred
        obtain ⟨-, -, h3⟩ := (reducedB_append _ _).1 hr
        obtain ⟨z, hz⟩ : ∃ z, (x :: g).getLast? = some z :=
          Option.ne_none_iff_exists'.mp (by simp)
        exact h3 z z hz (by rw [List.head?_reverse, hz]) rfl
    have hpar : hw.length % 2 = 0 := by
      have := rlen_parity (t.word ++ u.word)
      rw [List.length_append, Refl.word_length, Refl.word_length] at this
      unfold rlen at this
      rw [← hhw] at this
      omega
    have hlenk : 2 ≤ k.length := by
      have := congrArg List.length hgk
      simp only [List.length_append, List.length_reverse] at this
      have : k.length ≠ 0 := fun e => hk0 (List.eq_nil_of_length_eq_zero e)
      omega
    have hcyc : k.head? ≠ k.getLast? := by
      rcases hc with hc | hc
      · exact absurd hlenk (by omega)
      · exact hc
    -- conjugate everything by `g`
    let cj : Refl → Refl := fun s => ⟨g.reverse ++ s.v, s.i⟩
    have hcjw : ∀ s : Refl, groupElt (cj s).word =
        groupElt g.reverse * groupElt s.word * groupElt g := by
      intro s
      show groupElt (Refl.word ⟨g.reverse ++ s.v, s.i⟩) = _
      rw [word_split, List.reverse_reverse, groupElt_append, groupElt_append]
    have hconj : ∀ v w : Refl, groupElt (v.word ++ w.word) = groupElt hw →
        groupElt ((cj v).word ++ (cj w).word) = groupElt k := by
      intro v w hvw
      rw [groupElt_append, hcjw, hcjw]
      have e : groupElt g.reverse * groupElt v.word * groupElt g *
          (groupElt g.reverse * groupElt w.word * groupElt g) =
          groupElt g.reverse * groupElt (v.word ++ w.word) * groupElt g := by
        rw [groupElt_append]
        simp only [mul_assoc, groupElt_mul_reverse_cancel]
      rw [e, hvw, hgk, groupElt_append, groupElt_append]
      simp only [mul_assoc, groupElt_reverse_mul_cancel]
      rw [groupElt_reverse_mul, mul_one]
    have hmain := main_cyc p hp k hk hlenk hcyc (cj t) (cj u) (cj t') (cj u')
      (hconj t u hgw.symm) (hconj t' u' (h.trans hgw.symm))
    have hς : ∀ s : Refl, varsigma p (cj s) = nativeRho p g.reverse (varsigma p s) := by
      intro s
      exact varsigma_append p g.reverse s.v s.i
    rw [hς, hς, hς, hς, ← nativeRho_jordanMul p hp, ← nativeRho_jordanMul p hp] at hmain
    have := congrArg (nativeRho p g) hmain
    rwa [nativeRho_reverse_right p hp, nativeRho_reverse_right p hp] at this

/-- **lem:cer:h5:refl(a), proved** (no hypotheses; `SerreAxisProposition` is not needed). -/
theorem reflectionClassConsistency : ReflectionClassConsistency := by
  intro p hp t u t' u' h
  rcases h with h | h
  · exact consistency_same p hp t u t' u'
      (by rw [← groupElt_reduceRW (t'.word ++ u'.word), h, groupElt_reduceRW])
  · have e : (t.word ++ u.word).reverse = u.word ++ t.word := by
      rw [List.reverse_append, Refl.word_reverse, Refl.word_reverse]
    rw [e] at h
    rw [jordanMul_comm (varsigma p t)]
    exact consistency_same p hp u t t' u'
      (by rw [← groupElt_reduceRW (t'.word ++ u'.word), h, groupElt_reduceRW])

/-- The horizon-five clause from lem:cer:h5:seven alone. -/
theorem horizonFive_of_seven (h7 : TransferThroughSeven) : HorizonFiveClause :=
  horizonFive_of_refl_a_and_seven reflectionClassConsistency h7

end AlbertSequential.HorizonFive
