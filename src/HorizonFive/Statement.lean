module

public import Interfaces.WordsAndCertificates
public import UniversalProjectionAlgebra
public import NativeWordDuality
public import NativeAlbertLaws

/-! # Horizon five: the statement

Paper: core `rem:cer:fivestep`:
"For any four atoms of J ... no projective equality supported on words of length at most five
is violated from any state of J."  Companion appendix `app:cert:h5` proves it in the form
"if `c` is supported on words of length at most five and `E(c) = 0`, then `f(c)(p) = 0`".

Lean correspondence:

* tests: `Fin 4`; words: the chronological `Word (Fin 4)` (first outcome first);
  unreduced words are allowed, as in the paper (part (b) makes reduction harmless);
* `c`: a finitely supported real function on words, `WordCombination`;
* `E(c)`: `specialValue c`, the combination `Σ c_w E_w` of the Lüders effects
  `E_w = wordOperator P w = (q_1 ⋯ q_k)(q_k ⋯ q_1)` in the universal real *-algebra
  `UniversalProjectionAlgebra 4` generated by four self-adjoint idempotents.  This algebra is
  the paper's `ℝ[ℤ₂^{*4}]` under `p_i = (1 + r_i)/2`; the identification itself is not
  formalised and is not needed: every statement here is about the presented algebra;
* `f(c)(p)`: `nativeEffectValue p c = Σ c_w nativeWordEffect p w` in the native Albert algebra;
* states: `IsDensity ρ`; the table is `nativeWordProbability p ρ w = ⟨ρ, f(w)(p)⟩`.

The hypothesis `E(c) = 0` is the paper's own reformulation of "c is a projective equality"
via part (a); the hard direction of part (a) ("projective equality ⇒ E(c) = 0") is not
formalised.  The easy direction (`E(c) = 0` ⇒ the equality holds in every algebraic
projective model) is proved in `HorizonFive.Bridge`. -/

set_option autoImplicit false
@[expose] public section
noncomputable section
namespace AlbertSequential.HorizonFive

open AlbertSequential AlbertSequential.NativeAnalysis

/-- The four tests `A, B, C, D` are `0, 1, 2, 3`. -/
abbrev Test := Fin 4

/-- A finitely supported real combination `c` of words. -/
abbrev WordCombination := Word Test →₀ ℝ

/-- `c` is supported on words of length at most `L`. -/
def SupportedWithin (c : WordCombination) (L : ℕ) : Prop :=
  ∀ w ∈ c.support, w.length ≤ L

/-- The four universal projections `P_i`. -/
def universalTests : Test → UniversalProjectionAlgebra 4 := fun i => universalProjection i

/-- The paper's `E(c) = Σ_w c_w E_w`, in the universal algebra of four projections. -/
def specialValue (c : WordCombination) : UniversalProjectionAlgebra 4 :=
  c.sum fun w a => a • wordOperator universalTests w

/-- The paper's `f(c)(p) = Σ_w c_w U_{q_1} ⋯ U_{q_k} e` in the Albert algebra. -/
def nativeEffectValue (p : Test → Albert) (c : WordCombination) : Albert :=
  c.sum fun w a => a • nativeWordEffect p w

/-- The value `Σ_w c_w Pr_ρ(w)` of the combination on the native table from `ρ`. -/
def nativeTableValue (p : Test → Albert) (ρ : Albert) (c : WordCombination) : ℝ :=
  c.sum fun w a => a * nativeWordProbability p ρ w

/-- **The horizon-five clause** (core `rem:cer:fivestep`, every four atoms,
any state): for any four atoms, a combination of words of length at most five with
`E(c) = 0` has value zero on the native table from every state. -/
def HorizonFiveClause : Prop :=
  ∀ p : Test → Albert, (∀ i, IsAtom (p i)) →
    ∀ c : WordCombination, SupportedWithin c 5 → specialValue c = 0 →
      ∀ ρ : Albert, IsDensity ρ → nativeTableValue p ρ c = 0

/-- The effect form `f(c)(p) = 0` proved in companion `app:cert:h5` (stronger: no state appears). -/
def HorizonFiveEffectClause : Prop :=
  ∀ p : Test → Albert, (∀ i, IsAtom (p i)) →
    ∀ c : WordCombination, SupportedWithin c 5 → specialValue c = 0 →
      nativeEffectValue p c = 0

/-- `y ↦ ⟨ρ, y⟩` as a linear map. -/
def pairingLinear (ρ : Albert) : Albert →ₗ[ℝ] ℝ where
  toFun y := tracePairing ρ y
  map_add' y z := tracePairing_add_right ρ y z
  map_smul' r y := by simp [tracePairing_smul_right]

theorem nativeTableValue_eq_pairing (p : Test → Albert) (ρ : Albert) (c : WordCombination) :
    nativeTableValue p ρ c = tracePairing ρ (nativeEffectValue p c) := by
  unfold nativeTableValue nativeEffectValue
  change _ = pairingLinear ρ (c.sum fun w a => a • nativeWordEffect p w)
  rw [map_finsuppSum]
  refine Finsupp.sum_congr fun w _ => ?_
  rw [map_smul, smul_eq_mul]
  simp only [pairingLinear, LinearMap.coe_mk, AddHom.coe_mk]
  rw [nativeWordProbability_eq_pairing]

/-- The effect form implies the table form (states are not even needed). -/
theorem horizonFiveClause_of_effectClause (h : HorizonFiveEffectClause) :
    HorizonFiveClause := by
  intro p hp c hc hE ρ _
  rw [nativeTableValue_eq_pairing, h p hp c hc hE]
  unfold tracePairing
  rw [jordanMul_zero_right]
  exact Finset.sum_eq_zero fun _ _ => rfl

end AlbertSequential.HorizonFive
