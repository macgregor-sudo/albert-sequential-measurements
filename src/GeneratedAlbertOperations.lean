module

public import NativeOrbitLifts
public import EffectLiftEmbedding

/-!
The actual full unital Jordan subalgebra generated by an atom menu, represented
by its proved-equal reflection-orbit span. This subtype can be proper. No
Jordan product, unit or effect is replaced by coordinatewise operations.
-/
@[expose] public section
noncomputable section
namespace AlbertSequential
open NativeAnalysis

abbrev GeneratedAlbert {ι : Type*} (p : ι → Albert) (hp : ∀ i, IsAtom (p i)) :=
  ↥(nativeOrbitSpan p hp)

section Generated
variable {ι : Type*} (p : ι → Albert) (hp : ∀ i, IsAtom (p i))

def generatedUnit : GeneratedAlbert p hp := ⟨albertUnit, nativeUnit_mem_orbitSpan p hp⟩

def generatedOrbitPoint (α : ReflectionOrbitLabel ι) : GeneratedAlbert p hp :=
  ⟨nativeOrbitPoint p hp α, nativeOrbitPoint_mem_span p hp α⟩

def generatedJordanProduct : GeneratedAlbert p hp →ₗ[ℝ]
    GeneratedAlbert p hp →ₗ[ℝ] GeneratedAlbert p hp where
  toFun x :=
    { toFun y := ⟨jordanMul x y, nativeOrbitSpan_product p hp x.property y.property⟩
      map_add' y z := Subtype.ext (jordanMul_add_right x y z)
      map_smul' r y := Subtype.ext (jordanMul_smul_right r x y) }
  map_add' x y := by ext z; exact jordanMul_add_left x y z
  map_smul' r x := by ext z; exact jordanMul_smul_left r x z

theorem generatedJordanProduct_unit (x : GeneratedAlbert p hp) :
    generatedJordanProduct p hp (generatedUnit p hp) x = x :=
  Subtype.ext (jordanMul_albertUnit_left x)

theorem generatedOrbitPoints_span :
    Submodule.span ℝ (Set.range (unitAndAtomLabels (generatedUnit p hp) (generatedOrbitPoint p hp))) = ⊤ := by
  have hmem : ∀ i : Option (ReflectionOrbitLabel ι),
      unitAndAtomLabels albertUnit (nativeOrbitPoint p hp) i ∈ nativeOrbitSpan p hp := by
    intro i
    cases i with
    | none => exact nativeUnit_mem_orbitSpan p hp
    | some α => exact nativeOrbitPoint_mem_span p hp α
  have h := (Submodule.span_range_subtype_eq_top_iff (nativeOrbitSpan p hp) hmem).mpr rfl
  have hlabels : (fun i => (⟨unitAndAtomLabels albertUnit (nativeOrbitPoint p hp) i, hmem i⟩ : GeneratedAlbert p hp)) =
      unitAndAtomLabels (generatedUnit p hp) (generatedOrbitPoint p hp) := by
    funext i
    cases i <;> rfl
  rw [hlabels] at h
  exact h

theorem nativeTest_mem_orbitSpan (i : ι) : p i ∈ nativeOrbitSpan p hp := by
  simpa only [nativeOrbitPoint, nativeReflectionWordAutomorphism,
    nativeAutomorphismIdentity_apply] using nativeOrbitPoint_mem_span p hp ([], i)

theorem nativeOutcome_mem_orbitSpan (a : Outcome ι) : nativeOutcome p a ∈ nativeOrbitSpan p hp := by
  rcases a with ⟨i, b⟩
  cases b
  · exact (nativeOrbitSpan p hp).sub_mem (nativeUnit_mem_orbitSpan p hp) (nativeTest_mem_orbitSpan p hp i)
  · exact nativeTest_mem_orbitSpan p hp i

theorem nativeWordEffect_mem_orbitSpan (w : Word ι) : nativeWordEffect p w ∈ nativeOrbitSpan p hp := by
  induction w with
  | nil => exact nativeUnit_mem_orbitSpan p hp
  | cons a w ih =>
      exact nativeQuadraticMap_mem_subalgebra (nativeOrbitJordanSubalgebra p hp)
        (nativeOutcome_mem_orbitSpan p hp a) ih

def generatedWordEffect (w : Word ι) : GeneratedAlbert p hp :=
  ⟨nativeWordEffect p w, nativeWordEffect_mem_orbitSpan p hp w⟩

def generatedOutcomeUpdate (a : Outcome ι) : Module.End ℝ (GeneratedAlbert p hp) where
  toFun x := ⟨quadraticMap (nativeOutcome p a) x,
    nativeQuadraticMap_mem_subalgebra (nativeOrbitJordanSubalgebra p hp)
      (nativeOutcome_mem_orbitSpan p hp a) x.property⟩
  map_add' x y := Subtype.ext (quadraticMap_add_right _ x y)
  map_smul' r x := Subtype.ext (quadraticMap_smul_right r _ x)

theorem generatedWordEffect_cons (a : Outcome ι) (w : Word ι) :
    generatedWordEffect p hp (a :: w) = generatedOutcomeUpdate p hp a (generatedWordEffect p hp w) := rfl

def generatedReflectionUpdate (α : ReflectionOrbitLabel ι) : Module.End ℝ (GeneratedAlbert p hp) where
  toFun x := ⟨quadraticMap ((2 : ℝ) • nativeOrbitPoint p hp α - albertUnit) x,
    nativeOrbitSpan_reflection p hp α x.property⟩
  map_add' x y := Subtype.ext (quadraticMap_add_right _ x y)
  map_smul' r x := Subtype.ext (quadraticMap_smul_right r _ x)

def generatedOrbitWeight (α : ReflectionOrbitLabel ι) : GeneratedAlbert p hp →ₗ[ℝ] ℝ :=
  (nativePairingFunctional (nativeOrbitPoint p hp α)).comp (nativeOrbitSpan p hp).subtype

def generatedExpectation (ρ : Albert) : GeneratedAlbert p hp →ₗ[ℝ] ℝ :=
  (nativePairingFunctional ρ).comp (nativeOrbitSpan p hp).subtype

theorem generatedReflection_unit (α : ReflectionOrbitLabel ι) :
    generatedReflectionUpdate p hp α (generatedUnit p hp) = generatedUnit p hp :=
  Subtype.ext (idempotent_symmetry_unit _ (nativeOrbitPoint_isAtom p hp α).1)

theorem generatedReflection_label (α β : ReflectionOrbitLabel ι) :
    generatedReflectionUpdate p hp α (generatedOrbitPoint p hp β) =
      generatedOrbitPoint p hp (reflectedOrbitLabel α β) :=
  Subtype.ext (nativeOrbitPoint_reflected_label p hp α β).symm

theorem generatedOrbitWeight_unit (α : ReflectionOrbitLabel ι) :
    generatedOrbitWeight p hp α (generatedUnit p hp) = 1 :=
  (tracePairing_unit_right _).trans (nativeOrbitPoint_isAtom p hp α).2

theorem generatedOrbitWeight_symmetric (α β : ReflectionOrbitLabel ι) :
    generatedOrbitWeight p hp α (generatedOrbitPoint p hp β) =
      generatedOrbitWeight p hp β (generatedOrbitPoint p hp α) := tracePairing_comm _ _

theorem generatedPeirce_identity (α : ReflectionOrbitLabel ι) (x : GeneratedAlbert p hp) :
    generatedJordanProduct p hp (generatedOrbitPoint p hp α) x =
      generatedOrbitWeight p hp α x • generatedOrbitPoint p hp α + (1 / 4 : ℝ) •
        (x - generatedReflectionUpdate p hp α x) := by
  apply Subtype.ext
  change jordanMul (nativeOrbitPoint p hp α) x =
    tracePairing (nativeOrbitPoint p hp α) x • nativeOrbitPoint p hp α + (1 / 4 : ℝ) •
      ((x : Albert) - quadraticMap ((2 : ℝ) • nativeOrbitPoint p hp α - albertUnit) x)
  rw [peirce_identity, quadraticMap_atom _ _ (nativeOrbitPoint_isAtom p hp α)]

end Generated
end AlbertSequential
