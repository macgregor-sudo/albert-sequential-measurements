module

public import JordanPowerAssociativity

/-! The associative algebra generated by one actual Jordan element, as a
literal subspace with proved product closure and associativity. -/

@[expose] public section
noncomputable section
namespace AlbertSequential.UnitalJordanProduct
variable {E : Type*} [AddCommGroup E] [Module ℝ E] (P : UnitalJordanProduct E)

def powerSpan (a : E) : Submodule ℝ E := Submodule.span ℝ (Set.range (P.jordanPower a))

theorem jordanPower_mem_powerSpan (a : E) (n : ℕ) : P.jordanPower a n∈P.powerSpan a :=
  Submodule.subset_span ⟨n,rfl⟩

theorem unit_mem_powerSpan (a : E) : P.unit∈P.powerSpan a := by
  rw [← P.jordanPower_zero a]
  exact P.jordanPower_mem_powerSpan a 0

theorem generator_mem_powerSpan (a : E) : a∈P.powerSpan a := by
  simpa only [P.jordanPower_one] using P.jordanPower_mem_powerSpan a 1

theorem powerSpan_product_mem (a x y : E) (hx : x∈P.powerSpan a)
    (hy : y∈P.powerSpan a) : P.product x y∈P.powerSpan a := by
  apply LinearMap.BilinMap.apply_apply_mem_of_mem_span
    (P.powerSpan a) (Set.range (P.jordanPower a)) (Set.range (P.jordanPower a))
    P.product ?_ x y hx hy
  rintro _ ⟨m,rfl⟩ _ ⟨n,rfl⟩
  rw [P.jordanPower_mul]
  exact P.jordanPower_mem_powerSpan a (m+n)

/-- Power associativity extends by three linear span inductions; it is asserted
only on the one-generator space, never on all of E. -/
theorem powerSpan_associative (a x y z : E) (hx : x∈P.powerSpan a)
    (hy : y∈P.powerSpan a) (hz : z∈P.powerSpan a) :
    P.product (P.product x y) z=P.product x (P.product y z) := by
  have hZ (m n : ℕ) (z : E) (hz : z∈P.powerSpan a) :
      P.product (P.product (P.jordanPower a m) (P.jordanPower a n)) z=
        P.product (P.jordanPower a m) (P.product (P.jordanPower a n) z) := by
    apply LinearMap.eqOn_span (f := P.product (P.product (P.jordanPower a m) (P.jordanPower a n)))
      (g := (P.product (P.jordanPower a m)).comp (P.product (P.jordanPower a n))) ?_ hz
    rintro _ ⟨k,rfl⟩
    change P.product (P.product (P.jordanPower a m) (P.jordanPower a n)) (P.jordanPower a k)=
      P.product (P.jordanPower a m) (P.product (P.jordanPower a n) (P.jordanPower a k))
    simp only [P.jordanPower_mul,Nat.add_assoc]
  have hY (m : ℕ) (y z : E) (hy : y∈P.powerSpan a) (hz : z∈P.powerSpan a) :
      P.product (P.product (P.jordanPower a m) y) z=
        P.product (P.jordanPower a m) (P.product y z) := by
    apply LinearMap.eqOn_span
      (f := (P.product.flip z).comp (P.product (P.jordanPower a m)))
      (g := (P.product (P.jordanPower a m)).comp (P.product.flip z)) ?_ hy
    rintro _ ⟨n,rfl⟩
    exact hZ m n z hz
  apply LinearMap.eqOn_span (f := (P.product.flip z).comp (P.product.flip y))
    (g := P.product.flip (P.product y z)) ?_ hx
  rintro _ ⟨m,rfl⟩
  exact hY m y z hy hz

/-- Actual restricted product; its Jordan law is inherited, its associativity
was separately proved above. -/
def powerSpanProduct (a : E) : UnitalJordanProduct (P.powerSpan a) where
  product :=
    { toFun := fun x =>
        { toFun := fun y => ⟨P.product x.val y.val,P.powerSpan_product_mem a x.val y.val x.property y.property⟩
          map_add' := fun y z => Subtype.ext ((P.product x.val).map_add y.val z.val)
          map_smul' := fun r y => Subtype.ext ((P.product x.val).map_smul r y.val) }
      map_add' := fun x y => LinearMap.ext fun z =>
        Subtype.ext (LinearMap.congr_fun (P.product.map_add x.val y.val) z.val)
      map_smul' := fun r x => LinearMap.ext fun y =>
        Subtype.ext (LinearMap.congr_fun (P.product.map_smul r x.val) y.val) }
  unit := ⟨P.unit,P.unit_mem_powerSpan a⟩
  commutative x y := Subtype.ext (P.commutative x.val y.val)
  unit_left x := Subtype.ext (P.unit_left x.val)
  jordan_identity x y := Subtype.ext (P.jordan_identity x.val y.val)

@[simp] theorem powerSpanProduct_apply (a : E) (x y : P.powerSpan a) :
    ((P.powerSpanProduct a).product x y).val=P.product x.val y.val := rfl

@[simp] theorem powerSpanProduct_unit (a : E) : (P.powerSpanProduct a).unit.val=P.unit := rfl

theorem powerSpanProduct_associative (a : E) (x y z : P.powerSpan a) :
    (P.powerSpanProduct a).product ((P.powerSpanProduct a).product x y) z=
      (P.powerSpanProduct a).product x ((P.powerSpanProduct a).product y z) :=
  Subtype.ext (P.powerSpan_associative a x.val y.val z.val x.property y.property z.property)

end AlbertSequential.UnitalJordanProduct
