@[expose] public section
set_option autoImplicit false
noncomputable section

namespace AlbertSequential

open NativeAnalysis

/-- At most three arbitrary compact Albert idempotents lie in a proper unital subalgebra. -/
theorem not_generatesAlbert_of_at_most_three_idempotents {n : ℕ} (hn : n ≤ 3)
    (q : Fin n → Albert) (hq : ∀ i, jordanMul (q i) (q i) = q i) : ¬ GeneratesAlbert q := by
  classical
  have hchoices (i : Fin n) : ∃ r : Albert,
      IsAtom r ∧ (q i = 0 ∨ q i = albertUnit ∨ q i = r ∨ q i = albertUnit - r) := by
    rcases native_idempotent_classification (q i) (hq i) with h | h | h | h
    · exact ⟨diagAtom 0, diagAtom_isAtom 0, Or.inl h⟩
    · exact ⟨diagAtom 0, diagAtom_isAtom 0, Or.inr (Or.inl h)⟩
    · exact ⟨q i, h, Or.inr (Or.inr (Or.inl rfl))⟩
    · exact ⟨albertUnit - q i, h, Or.inr (Or.inr (Or.inr (by abel)))⟩
  choose r hra hrq using hchoices
  let R (i : Fin 3) : Albert := if hi : i.val < n then r ⟨i.val, hi⟩ else diagAtom 0
  have hR (i : Fin 3) : IsAtom (R i) := by
    dsimp only [R]
    split
    · exact hra _
    · exact diagAtom_isAtom 0
  have hr (i : Fin n) : R (Fin.castLE hn i) = r i := dite_eq_left i.isLt
  intro hgen
  have hgenR : GeneratesAlbert R := by
    intro x S hS
    apply hgen x S
    intro i
    have hri : r i ∈ S.carrier := hr i ▸ hS (Fin.castLE hn i)
    rcases hrq i with h | h | h | h
    · exact h ▸ S.carrier.zero_mem
    · exact h ▸ S.unit_mem
    · exact h ▸ hri
    · exact h ▸ S.carrier.sub_mem S.unit_mem hri
  let p (i : Fin 3) : AlbertChallenge.Albert := R i
  have hp (i : Fin 3) : AlbertChallenge.IsAtom (p i) :=
    (AlbertChallenge.Bridge.isAtom_toT (p i)).mp (hR i)
  exact (AlbertChallenge.Bridge.three_atoms_bridge p hp).1
    ((AlbertChallenge.Bridge.generates_toT p).mp hgenR)

namespace UnitalJordanProduct

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (P : UnitalJordanProduct E)

/-- The algebra actually generated by at most three tests has no Albert ideal. -/
theorem not_albertIdeal_generatedMenu_of_at_most_three {n : ℕ} (hn : n ≤ 3)
    (p : Fin n → E) (hp : ∀ i, P.product (p i) (p i) = p i)
    (hinner : ∀ x y z, inner ℝ (P.product x y) z = inner ℝ x (P.product y z)) :
    ¬ Nonempty (P.generatedMenuProduct p).AlbertIdeal := by
  rintro ⟨I⟩
  let B := P.generatedMenuProduct p
  let t (i : Fin n) := P.generatedMenuTest p i
  let q (i : Fin n) := I.projection (t i)
  have hform := P.generatedMenuProduct_inner p hinner
  have hid (i : Fin n) : B.product (t i) (t i) = t i := Subtype.ext (hp i)
  have hq (i : Fin n) : jordanMul (q i) (q i) = q i := by
    change jordanMul (I.projection (t i)) (I.projection (t i)) = I.projection (t i)
    rw [← I.projection_product hform, hid]
  have hgen := I.generatesAlbert_projected_nonzero hform t (P.generatedMenuProduct_generates p)
  apply not_generatesAlbert_of_at_most_three_idempotents hn q hq
  intro x S hS
  exact hgen x S fun i => hS i.val

/-- Core Corollary 4.13 for any menu of at most three tests, with one finite
complex projective model carrying a density-matrix state. -/
theorem exists_projectiveRepresentation_of_at_most_three_native {n : ℕ} (hn : n ≤ 3)
    (p : Fin n → E) (hp : ∀ i, P.product (p i) (p i) = p i)
    (hinner : ∀ x y z, inner ℝ (P.product x y) z = inner ℝ x (P.product y z))
    (ρ : E) (hρ : P.IsCanonicalDensity (P.formallyReal_of_associative_inner hinner) ρ) :
    ∃ (d : ℕ) (M : AlbertChallenge.ProjectiveRepresentation n ℂ (EuclideanSpace ℂ (Fin d))),
      M.HasDensityState ∧ ∀ w, M.probability w =
        P.canonicalTraceOfFormallyReal (P.formallyReal_of_associative_inner hinner)
          (P.sequentialBranchState p ρ w) :=
  P.exists_projectiveRepresentation_of_zeroAlbertWeights_in_generatedMenu_native p hp hinner ρ hρ
    (fun I => (P.not_albertIdeal_generatedMenu_of_at_most_three hn p hp hinner ⟨I⟩).elim)

end UnitalJordanProduct
end AlbertSequential
