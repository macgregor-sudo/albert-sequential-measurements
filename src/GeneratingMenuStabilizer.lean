module
public import Interfaces.Geometry

/-! Pointwise stabilizer of a generating menu, core §5. -/
@[expose] public section
namespace AlbertSequential

/-- Two automorphisms agree on the Jordan subalgebra generated by their equalizer. -/
theorem agree_on_generated_of_agree_on_menu {ι : Type*} (p : ι → Albert)
    (g h : NativeAlbertAutomorphism) (hp : ∀ i, g.linearEquiv (p i) = h.linearEquiv (p i))
    {x : Albert} (hx : InGeneratedAlgebra p x) : g.linearEquiv x = h.linearEquiv x := by
  let B : NativeJordanSubalgebra := {
    carrier := LinearMap.ker (g.linearEquiv.toLinearMap - h.linearEquiv.toLinearMap)
    unit_mem := by simp [LinearMap.mem_ker, g.preserves_unit, h.preserves_unit]
    product_mem := by
      intro a ha b hb
      change g.linearEquiv a - h.linearEquiv a = 0 at ha
      change g.linearEquiv b - h.linearEquiv b = 0 at hb
      change g.linearEquiv (jordanMul a b) - h.linearEquiv (jordanMul a b) = 0
      rw [g.preserves_product, h.preserves_product, sub_eq_zero.mp ha, sub_eq_zero.mp hb, sub_self] }
  exact sub_eq_zero.mp (hx B (fun i => sub_eq_zero.mpr (hp i)))

theorem automorphisms_eq_on_generating_menu {ι : Type*} (p : ι → Albert)
    (hg : GeneratesAlbert p) (g h : NativeAlbertAutomorphism)
    (hp : ∀ i, g.linearEquiv (p i) = h.linearEquiv (p i)) : g = h := by
  have he : g.linearEquiv = h.linearEquiv := LinearEquiv.ext fun x =>
    agree_on_generated_of_agree_on_menu p g h hp (hg x)
  cases g
  cases h
  cases he
  rfl

end AlbertSequential
