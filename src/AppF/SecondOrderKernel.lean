theorem Wperp_decomp (v : Albert) (hv : v ∈ Wperp) :
    v = ((v.2 0).1.imJ) • castA eunit_0_2 +
      ((v.2 0).1.imK) • castA eunit_0_3 +
      ((v.2 0).2.re) • castA eunit_0_4 +
      ((v.2 0).2.imI) • castA eunit_0_5 +
      ((v.2 0).2.imJ) • castA eunit_0_6 +
      ((v.2 0).2.imK) • castA eunit_0_7 +
      ((v.2 1).1.imJ) • castA eunit_1_2 +
      ((v.2 1).1.imK) • castA eunit_1_3 +
      ((v.2 1).2.re) • castA eunit_1_4 +
      ((v.2 1).2.imI) • castA eunit_1_5 +
      ((v.2 1).2.imJ) • castA eunit_1_6 +
      ((v.2 1).2.imK) • castA eunit_1_7 +
      ((v.2 2).1.imJ) • castA eunit_2_2 +
      ((v.2 2).1.imK) • castA eunit_2_3 +
      ((v.2 2).2.re) • castA eunit_2_4 +
      ((v.2 2).2.imI) • castA eunit_2_5 +
      ((v.2 2).2.imJ) • castA eunit_2_6 +
      ((v.2 2).2.imK) • castA eunit_2_7 := by
  obtain ⟨hd, ho⟩ := hv
  apply albert_ext'
  all_goals try apply oct_ext
  all_goals simp [hd, (ho 0).1, (ho 0).2, (ho 1).1, (ho 1).2, (ho 2).1, (ho 2).2, castA_d0,
    castA_d1, castA_d2, castA_o0, castA_o1, castA_o2, castO_fst', castO_snd', castQ_re', castQ_imI',
    castQ_imJ', castQ_imK', oct_add_fst, oct_add_snd, oct_smul_fst, oct_smul_snd, toR_rat, albert_add_fst', albert_add_snd', albert_smul_fst', albert_smul_snd',
    Prod.smul_fst, Prod.smul_snd, Quaternion.re_smul, Quaternion.imI_smul, Quaternion.imJ_smul,
    Quaternion.imK_smul, eo, eunit_0_2, eunit_0_3, eunit_0_4, eunit_0_5, eunit_0_6, eunit_0_7, eunit_1_2, eunit_1_3, eunit_1_4, eunit_1_5, eunit_1_6, eunit_1_7, eunit_2_2, eunit_2_3, eunit_2_4, eunit_2_5, eunit_2_6, eunit_2_7]

/-- `prop:so:kernel`(b), Jacobson-free: every real-linear Jordan homomorphism `f : E₂ → A⁺`
(`A` an associative real algebra, unital or not; `f` unital or not) vanishes on `K = t²W^⊥`. -/
theorem E2_jordanHom_kills_K {A : Type*} [NonUnitalRing A] [Module ℝ A] [IsScalarTower ℝ A A]
    [SMulCommClass ℝ A A] (f : E2 →ₗ[ℝ] A) (hf : IsE2JordanHom f) (k : E2) (hk : k.1 ∈ Kso) :
    f k = 0 := by
  obtain ⟨h0, h1, h2⟩ := hk
  have hdec := Wperp_decomp k.1.2.2 h2
  let ι2 : Albert →ₗ[ℝ] J3 := (LinearMap.inr ℝ Albert (Albert × Albert)).comp
    (LinearMap.inr ℝ Albert Albert)
  let Sm : Submodule ℝ Albert := (kerIn f).comap ι2
  have hb : ∀ u : EA ℚ, castJ3 (ez, ez, u) ∈ kerIn f → castA u ∈ Sm := by
    intro u hu
    show ι2 (castA u) ∈ kerIn f
    have e : ι2 (castA u) = castJ3 (ez, ez, u) := by
      simp [ι2, castJ3, castA_ez]
    rw [e]; exact hu
  have hv : k.1.2.2 ∈ Sm := by
    rw [hdec]
    repeat' first
      | apply Sm.add_mem
      | apply Sm.smul_mem
    all_goals first
      | exact hb _ (basis_0_2_mem f hf)
      | exact hb _ (basis_0_3_mem f hf)
      | exact hb _ (basis_0_4_mem f hf)
      | exact hb _ (basis_0_5_mem f hf)
      | exact hb _ (basis_0_6_mem f hf)
      | exact hb _ (basis_0_7_mem f hf)
      | exact hb _ (basis_1_2_mem f hf)
      | exact hb _ (basis_1_3_mem f hf)
      | exact hb _ (basis_1_4_mem f hf)
      | exact hb _ (basis_1_5_mem f hf)
      | exact hb _ (basis_1_6_mem f hf)
      | exact hb _ (basis_1_7_mem f hf)
      | exact hb _ (basis_2_2_mem f hf)
      | exact hb _ (basis_2_3_mem f hf)
      | exact hb _ (basis_2_4_mem f hf)
      | exact hb _ (basis_2_5_mem f hf)
      | exact hb _ (basis_2_6_mem f hf)
      | exact hb _ (basis_2_7_mem f hf)
  have hK : k.1 ∈ kerIn f := by
    have e : k.1 = ι2 k.1.2.2 := by
      simp only [ι2, LinearMap.comp_apply, LinearMap.inr_apply]
      exact Prod.ext h0 (Prod.ext h1 rfl)
    rw [e]; exact hv
  obtain ⟨k', hk', hval⟩ := hK
  have : k' = k := Subtype.ext hval
  rw [← this]; exact hk'

/-- Hence no injective Jordan homomorphism from `E₂` into any associative real algebra exists:
`E₂` is not special (since `K ≠ 0`). -/
theorem E2_not_special {A : Type*} [NonUnitalRing A] [Module ℝ A] [IsScalarTower ℝ A A]
    [SMulCommClass ℝ A A] (f : E2 →ₗ[ℝ] A) (hf : IsE2JordanHom f) : ¬ Function.Injective f := by
  intro hinj
  have hmem : castJ3 (ez, ez, eunit_0_2) ∈ E2 := castJ3_mem_E2_of ez_mem
  have hK : (castJ3 (ez, ez, eunit_0_2)) ∈ Kso := by
    refine ⟨castA_ez, castA_ez, ?_, ?_⟩
    · intro i; fin_cases i <;> simp [castJ3, castA, eunit_0_2, toR_rat]
    · intro k; fin_cases k <;> simp [castJ3, castA, castO, castQ, eunit_0_2, eo, toR_rat]
  have h0 := E2_jordanHom_kills_K f hf ⟨_, hmem⟩ hK
  have h1 : (⟨_, hmem⟩ : E2) = 0 := hinj (by rw [h0, map_zero])
  have h3 : castA eunit_0_2 = 0 := congrArg (fun x : E2 => x.1.2.2) h1
  have h4 := congrArg (fun x : Albert => (x.2 0).1.imJ) h3
  have h5 : ((0 : Albert).2 0).1.imJ = 0 := rfl
  simp only [castA_o0] at h4
  rw [h5] at h4
  simp [castO, castQ, eunit_0_2, eo, toR_rat] at h4

end

