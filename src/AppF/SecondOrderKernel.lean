/-! ## The native jet algebra -/

noncomputable section

abbrev J3 := Albert × Albert × Albert

/-- Graded Jordan product of `J[t]/(t³)`. -/
def j3mul (x y : J3) : J3 :=
  (jordanMul x.1 y.1, jordanMul x.1 y.2.1 + jordanMul x.2.1 y.1,
    (jordanMul x.1 y.2.2 + jordanMul x.2.1 y.2.1) + jordanMul x.2.2 y.1)

def j3Ops : JOps J3 := ⟨(· + ·), (· - ·), j3mul⟩

/-- `W = H₃(ℂ_i)`. -/
def Wso : Submodule ℝ Albert := standardComplexWindow.toSubalgebra.carrier

/-- `E₂ = W ⊕ tJ ⊕ t²J`. -/
def E2 : Submodule ℝ J3 := Submodule.comap (LinearMap.fst ℝ Albert (Albert × Albert)) Wso

theorem mem_E2 (x : J3) : x ∈ E2 ↔ x.1 ∈ Wso := Iff.rfl

theorem E2_mul_mem {x y : J3} (hx : x ∈ E2) (hy : y ∈ E2) : j3mul x y ∈ E2 :=
  standardComplexWindow.toSubalgebra.product_mem _ hx _ hy

/-- `W^⊥`: zero diagonal, off-diagonal entries in `ℂ_i^⊥`. -/
def Wperp : Submodule ℝ Albert where
  carrier := {v | (∀ i, v.1 i = 0) ∧ ∀ k, (v.2 k).1.re = 0 ∧ (v.2 k).1.imI = 0}
  add_mem' := by
    intro a b ha hb
    refine ⟨fun i => ?_, fun k => ?_⟩
    · rw [albert_add_fst', ha.1 i, hb.1 i, add_zero]
    · rw [albert_add_snd', oct_add_fst]
      constructor <;> simp [(ha.2 k).1, (ha.2 k).2, (hb.2 k).1, (hb.2 k).2]
  zero_mem' := by
    refine ⟨fun i => rfl, fun k => ⟨rfl, rfl⟩⟩
  smul_mem' := by
    intro c a ha
    refine ⟨fun i => ?_, fun k => ?_⟩
    · rw [albert_smul_fst', ha.1 i, mul_zero]
    · rw [albert_smul_snd', oct_smul_fst]
      constructor <;> simp [(ha.2 k).1, (ha.2 k).2]

/-- `K = t²W^⊥`. -/
def Kso : Submodule ℝ J3 where
  carrier := {x | x.1 = 0 ∧ x.2.1 = 0 ∧ x.2.2 ∈ Wperp}
  add_mem' := by
    rintro a b ⟨ha0, ha1, ha2⟩ ⟨hb0, hb1, hb2⟩
    exact ⟨by simp [ha0, hb0], by simp [ha1, hb1], Wperp.add_mem ha2 hb2⟩
  zero_mem' := ⟨rfl, rfl, Wperp.zero_mem⟩
  smul_mem' := by
    rintro c a ⟨ha0, ha1, ha2⟩
    exact ⟨by simp [ha0], by simp [ha1], Wperp.smul_mem c ha2⟩

theorem Kso_le_E2 : Kso ≤ E2 := by
  rintro x ⟨h0, -, -⟩
  show x.1 ∈ Wso
  rw [h0]; exact Wso.zero_mem

/-- The Jordan product on `E₂`. -/
def E2ops : JOps E2 := ⟨(· + ·), (· - ·), fun x y => ⟨j3mul x.1 y.1, E2_mul_mem x.2 y.2⟩⟩

/-- A real-linear Jordan homomorphism `E₂ → A⁺` (no unit condition on `f` or `A`). -/
def IsE2JordanHom {A : Type*} [NonUnitalRing A] [Module ℝ A] (f : E2 →ₗ[ℝ] A) : Prop :=
  ∀ x y : E2, f (E2ops.mul x y) = (1 / 2 : ℝ) • (f x * f y + f y * f x)

/-! ## Transport from the exact model -/

def castJ3 (x : EA ℚ × EA ℚ × EA ℚ) : J3 := (castA x.1, castA x.2.1, castA x.2.2)

theorem castA_ez : castA ez = 0 := by
  apply albert_ext' <;> simp [castA, ez, eo0, eo, castO, castQ, toR_rat] <;> rfl

theorem castJ3_add (x y : EA ℚ × EA ℚ × EA ℚ) : castJ3 (ej3Ops.add x y) = castJ3 x + castJ3 y := by
  simp only [castJ3, ej3Ops, castA_add]; rfl
theorem castJ3_sub (x y : EA ℚ × EA ℚ × EA ℚ) : castJ3 (ej3Ops.sub x y) = castJ3 x - castJ3 y := by
  simp only [castJ3, ej3Ops, castA_sub]; rfl
theorem castJ3_mul (x y : EA ℚ × EA ℚ × EA ℚ) :
    castJ3 (ej3Ops.mul x y) = j3mul (castJ3 x) (castJ3 y) := by
  simp only [castJ3, ej3Ops, ej3mul, castA_add, castA_jmul, j3mul]

theorem castJ3_psi (x y z : EA ℚ × EA ℚ × EA ℚ) :
    castJ3 (psi ej3Ops x y z) = psi j3Ops (castJ3 x) (castJ3 y) (castJ3 z) :=
  map_psi (o := ej3Ops) (o' := j3Ops) castJ3 castJ3_add castJ3_sub castJ3_mul x y z

/-! ## The kernel of `f` inside `J₃` -/

section Kernel

variable {A : Type*} [NonUnitalRing A] [Module ℝ A] [IsScalarTower ℝ A A] [SMulCommClass ℝ A A]
  (f : E2 →ₗ[ℝ] A) (hf : IsE2JordanHom f)

/-- `ker f`, viewed inside `J₃`. -/
def kerIn : Submodule ℝ J3 := (LinearMap.ker f).map E2.subtype

theorem mem_kerIn_of {x : J3} (hx : x ∈ E2) (h : f ⟨x, hx⟩ = 0) : x ∈ kerIn f :=
  ⟨⟨x, hx⟩, h, rfl⟩

include hf in
theorem psi_mem_kerIn {x y z : J3} (hx : x ∈ E2) (hy : y ∈ E2) (hz : z ∈ E2) :
    psi j3Ops x y z ∈ kerIn f := by
  refine ⟨psi E2ops ⟨x, hx⟩ ⟨y, hy⟩ ⟨z, hz⟩, ?_, ?_⟩
  · exact opsHom_kills_psi (o := E2ops) f (fun a b => map_add f a b) (fun a b => map_sub f a b)
      (fun a b => hf a b) _ _ _
  · exact map_psi (o := E2ops) (o' := j3Ops) Subtype.val (fun _ _ => rfl) (fun _ _ => rfl)
      (fun _ _ => rfl) _ _ _

include hf in
theorem mul_mem_kerIn {w e : J3} (hw : w ∈ E2) (he : e ∈ kerIn f) : j3mul w e ∈ kerIn f := by
  obtain ⟨e', he', rfl⟩ := he
  refine ⟨E2ops.mul ⟨w, hw⟩ e', ?_, rfl⟩
  have h0 : f e' = 0 := he'
  show f (E2ops.mul ⟨w, hw⟩ e') = 0
  rw [hf, h0, mul_zero, zero_mul, add_zero, smul_zero]

end Kernel

theorem castJ3_mem_E2_of {x : EA ℚ × EA ℚ × EA ℚ} (h : castA x.1 ∈ Wso) : castJ3 x ∈ E2 := h

theorem castA_mem_W_iff (x : EA ℚ) : castA x ∈ Wso ↔
    ExactScalar.toR x.o0.fst.j = 0 ∧ ExactScalar.toR x.o0.fst.k = 0 ∧ castQ x.o0.snd = 0 ∧
    ExactScalar.toR x.o1.fst.j = 0 ∧ ExactScalar.toR x.o1.fst.k = 0 ∧ castQ x.o1.snd = 0 ∧
    ExactScalar.toR x.o2.fst.j = 0 ∧ ExactScalar.toR x.o2.fst.k = 0 ∧ castQ x.o2.snd = 0 :=
  standardComplexWindow_contains_iff (castA x)

theorem castQ_zero_lit : castQ (⟨0, 0, 0, 0⟩ : EQ ℚ) = 0 := by
  apply Quaternion.ext <;> simp [castQ, toR_rat]

