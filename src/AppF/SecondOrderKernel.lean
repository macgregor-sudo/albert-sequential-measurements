section Generation

variable {A : Type*} [NonUnitalRing A] [Module ℝ A] [IsScalarTower ℝ A A] [SMulCommClass ℝ A A]
  (f : E2 →ₗ[ℝ] A) (hf : IsE2JordanHom f)
include hf

theorem z_mem (r : EA ℚ) : castJ3 (ez, r, ez) ∈ E2 := castJ3_mem_E2_of ez_mem
theorem w_mem {w : EA ℚ} (hw : castA w ∈ Wso) : castJ3 (w, ez, ez) ∈ E2 := castJ3_mem_E2_of hw

theorem P0_mem : castJ3 (ez, ez, psiQ0) ∈ kerIn f := by
  rw [← psi_value0, castJ3_psi]
  exact psi_mem_kerIn f hf (w_mem f hf xQ_mem) (w_mem f hf yQ_mem) (z_mem f hf zQ0)

theorem P1_mem : castJ3 (ez, ez, psiQ1) ∈ kerIn f := by
  rw [← psi_value1, castJ3_psi]
  exact psi_mem_kerIn f hf (w_mem f hf xQ_mem) (w_mem f hf yQ_mem) (z_mem f hf zQ1)

theorem P2_mem : castJ3 (ez, ez, psiQ2) ∈ kerIn f := by
  rw [← psi_value2, castJ3_psi]
  exact psi_mem_kerIn f hf (w_mem f hf xQ_mem) (w_mem f hf yQ_mem) (z_mem f hf zQ2)

theorem basis_0_2_mem : castJ3 (ez, ez, eunit_0_2) ∈ kerIn f := by
  have h : castJ3 (ej3Ops.mul (wQ8, ez, ez) (ez, ez, psiQ2)) ∈ kerIn f := (by rw [castJ3_mul]; exact mul_mem_kerIn f hf (w_mem f hf wQ8_mem) (P2_mem f hf))
  rw [gen_0_2] at h
  have h2 := (kerIn f).smul_mem (1 / (6 : ℝ)) h
  have e : (1 / (6 : ℝ)) • castJ3 (ez, ez, (eunit_0_2).smul (6)) = castJ3 (ez, ez, eunit_0_2) := by
    simp only [castJ3, castA_smul, castA_ez, toR_rat, Prod.smul_mk, smul_zero, smul_smul]
    norm_num
  rwa [e] at h2

theorem basis_0_3_mem : castJ3 (ez, ez, eunit_0_3) ∈ kerIn f := by
