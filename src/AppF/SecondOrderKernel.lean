def ej3mul (x y : EA ℚ × EA ℚ × EA ℚ) : EA ℚ × EA ℚ × EA ℚ :=
  (x.1.jmul y.1, (x.1.jmul y.2.1).add (x.2.1.jmul y.1),
    ((x.1.jmul y.2.2).add (x.2.1.jmul y.2.1)).add (x.2.2.jmul y.1))

def ej3Ops : JOps (EA ℚ × EA ℚ × EA ℚ) :=
  ⟨fun x y => (x.1.add y.1, x.2.1.add y.2.1, x.2.2.add y.2.2),
   fun x y => (x.1.sub y.1, x.2.1.sub y.2.1, x.2.2.sub y.2.2), ej3mul⟩

