module
public import CyclicRangeCompletion
public import GeneratedOrbitReconstruction

/-! Core Proposition 4.8 on the actual algebra generated by the tests. -/
@[expose] public section
noncomputable section
open scoped InnerProductSpace
namespace AlbertSequential.UnitalJordanProduct

variable {E I A : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    [Ring A] [StarRing A] [Module ℝ A] [IsScalarTower ℝ A A] [SMulCommClass ℝ A A] [StarModule ℝ A]
local instance : Algebra ℝ A := Algebra.ofModule smul_mul_assoc mul_smul_comm

theorem generated_cyclicHilbertJordanMap (P : UnitalJordanProduct E) (p : I → E)
    (M : AlgebraicProjectiveData I A)
    (hinner : ∀ x y z, inner ℝ (P.product x y) z = inner ℝ x (P.product y z))
    (hp : ∀ i, (P.generatedMenuProduct p).IsPrimitive (P.generatedMenuTest p i))
    (ρ : E) (hm : ∀ w, M.probability w =
      P.canonicalTraceOfFormallyReal (P.formallyReal_of_associative_inner hinner)
        (P.sequentialBranchState p ρ w)) :
    let B := P.generatedMenuProduct p
    let H := CyclicHilbert M →L[ℝ] CyclicHilbert M
    ∃ η : P.generatedMenuCarrier p →ₗ[ℝ] selfAdjoint H,
      (∀ x y, (η (B.product x y) : H) = associativeJordanProduct (η x : H) (η y : H)) ∧
      (η B.unit : H) = 1 ∧
      (∀ α : ReflectionOrbitLabel I, (η (B.reflectedMenuPoint (P.generatedMenuTest p) α.1 α.2) : H) =
        cyclicHilbertRepresentation M ((cyclicWordAlgebraEquiv M).symm (cyclicOrbitProjection M α))) ∧
      ∀ x, inner ℝ (cyclicHilbertVector M) ((η x : H) (cyclicHilbertVector M)) =
        P.canonicalTraceFormOfFormallyReal (P.formallyReal_of_associative_inner hinner) ρ x.val := by
  let B := P.generatedMenuProduct p
  let q := P.generatedMenuTest p
  let hfr := P.formallyReal_of_associative_inner hinner
  let ω := (P.canonicalPairingFunctional hfr ρ).comp (P.generatedMenuCarrier p).subtype
  have hB := P.generatedMenuProduct_inner p hinner
  have hg := P.generatedMenuProduct_generates p
  have hmatch (w) : M.probability w = ω (B.sequentialWordEffect q w) := by
    change M.probability w = P.canonicalPairingFunctional hfr ρ
      (((P.generatedMenuProduct p).sequentialWordEffect (P.generatedMenuTest p) w).val)
    rw [P.generatedMenu_sequentialWordEffect p, hm, P.canonicalTrace_sequentialBranchState]
  obtain ⟨η,hj,hu,ho,hs⟩ := B.primitive_orbit_cyclic_reconstruction q M hB hp hg ω hmatch
  exact exists_cyclicHilbertJordanMap_of_orbits M B.unit
    (fun α : ReflectionOrbitLabel I => B.reflectedMenuPoint q α.1 α.2) (cyclicOrbitProjection M)
    B.product (B.primitive_orbit_labels_span q hB hp hg)
    (fun α => orbitProjection_star M.projection M.selfAdjoint α.1 α.2) η hj hu ho ω hs

end AlbertSequential.UnitalJordanProduct
