module

public import GeneralEJAAlbertIdeal
public import BoundedWordEffects
public import QuaternionicProjectiveData

/-! Restrict the ambient EJA and initial state to the actual unital Jordan
algebra generated by the tests. Apply the positive Albert-weight obstruction
on this carrier, where the primitivity hypothesis belongs. -/

set_option autoImplicit false
@[expose] public section
noncomputable section

namespace AlbertSequential.UnitalJordanProduct

open scoped InnerProductSpace

variable {E ι : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  (P : UnitalJordanProduct E) (p : ι → E)

/-- Intersection of all unital Jordan subalgebras containing the test menu. -/
def generatedMenuCarrier : Submodule ℝ E :=
  sInf { S | P.unit ∈ S ∧ (∀ x ∈ S, ∀ y ∈ S, P.product x y ∈ S) ∧ ∀ i, p i ∈ S }

theorem unit_mem_generatedMenuCarrier : P.unit ∈ P.generatedMenuCarrier p :=
  Submodule.mem_sInf.mpr fun _ h => h.1

theorem test_mem_generatedMenuCarrier (i : ι) : p i ∈ P.generatedMenuCarrier p :=
  Submodule.mem_sInf.mpr fun _ h => h.2.2 i

theorem product_mem_generatedMenuCarrier {x y : E}
    (hx : x ∈ P.generatedMenuCarrier p) (hy : y ∈ P.generatedMenuCarrier p) :
    P.product x y ∈ P.generatedMenuCarrier p :=
  Submodule.mem_sInf.mpr fun S h =>
    h.2.1 _ (Submodule.mem_sInf.mp hx S h) _ (Submodule.mem_sInf.mp hy S h)

def generatedMenuProduct : UnitalJordanProduct (P.generatedMenuCarrier p) where
  unit := ⟨P.unit, P.unit_mem_generatedMenuCarrier p⟩
  product := LinearMap.mk₂ ℝ
    (fun x y => ⟨P.product x.val y.val, P.product_mem_generatedMenuCarrier p x.property y.property⟩)
    (fun x y z => Subtype.ext (LinearMap.congr_fun (P.product.map_add x.val y.val) z.val))
    (fun r x y => Subtype.ext (LinearMap.congr_fun (P.product.map_smul r x.val) y.val))
    (fun x y z => Subtype.ext ((P.product x.val).map_add y.val z.val))
    (fun r x y => Subtype.ext ((P.product x.val).map_smul r y.val))
  commutative x y := Subtype.ext (P.commutative x.val y.val)
  unit_left x := Subtype.ext (P.unit_left x.val)
  jordan_identity x y := Subtype.ext (P.jordan_identity x.val y.val)

def generatedMenuTest (i : ι) : P.generatedMenuCarrier p :=
  ⟨p i, P.test_mem_generatedMenuCarrier p i⟩

theorem generatedMenuProduct_inner
    (hinner : ∀ x y z, inner ℝ (P.product x y) z = inner ℝ x (P.product y z))
    (x y z : P.generatedMenuCarrier p) :
    inner ℝ ((P.generatedMenuProduct p).product x y) z =
      inner ℝ x ((P.generatedMenuProduct p).product y z) :=
  hinner x.val y.val z.val

theorem generatedMenuProduct_generates :
    (P.generatedMenuProduct p).GeneratesMenu (P.generatedMenuTest p) := by
  intro S hunit hclosed htest x
  let T := S.map (P.generatedMenuCarrier p).subtype
  have hTunit : P.unit ∈ T := ⟨(P.generatedMenuProduct p).unit, hunit, rfl⟩
  have hTprod : ∀ x ∈ T, ∀ y ∈ T, P.product x y ∈ T := by
    intro a ha b hb
    obtain ⟨a', ha', rfl⟩ := ha
    obtain ⟨b', hb', rfl⟩ := hb
    exact ⟨(P.generatedMenuProduct p).product a' b', hclosed a' ha' b' hb', rfl⟩
  have hTtest (i : ι) : p i ∈ T := ⟨P.generatedMenuTest p i, htest i, rfl⟩
  have hx : x.val ∈ T :=
    Submodule.mem_sInf.mp x.property T ⟨hTunit, hTprod, hTtest⟩
  obtain ⟨y, hy, heq⟩ := hx
  have hyx : y = x := Subtype.ext heq
  exact hyx ▸ hy

/-- Each nontrivial test is primitive or has primitive complement in the
generated algebra. -/
def IsBPrimitiveMenu : Prop :=
  let B := P.generatedMenuProduct p
  let pB := P.generatedMenuTest p
  ∀ i, pB i = 0 ∨ pB i = B.unit ∨ B.IsPrimitive (pB i) ∨ B.IsPrimitive (B.unit - pB i)

theorem generatedMenu_sequentialWordEffect (w : Word ι) :
    ((P.generatedMenuProduct p).sequentialWordEffect (P.generatedMenuTest p) w).val =
      P.sequentialWordEffect p w :=
  (P.generatedMenuProduct p).map_sequentialWordEffect P (P.generatedMenuCarrier p).subtype
    rfl (fun _ _ => rfl) (P.generatedMenuTest p) w

variable [FiniteDimensional ℝ E]

/-- Positive Albert weight excludes matching for B-primitive tests from a
canonical density of the general ambient EJA. -/
theorem no_algebraicModel_of_BPrimitiveMenu_albertWeight {A : Type*}
    [Ring A] [StarRing A] [Module ℝ A] [IsScalarTower ℝ A A]
    [SMulCommClass ℝ A A] [StarModule ℝ A]
    (hinner : ∀ x y z, inner ℝ (P.product x y) z = inner ℝ x (P.product y z))
    (hp : P.IsBPrimitiveMenu p)
    (I : (P.generatedMenuProduct p).AlbertIdeal)
    (ρ : E) (hρ : P.IsCanonicalDensity (P.formallyReal_of_associative_inner hinner) ρ)
    (hweight : 0 < P.canonicalTraceFormOfFormallyReal (P.formallyReal_of_associative_inner hinner) ρ
      ((P.generatedMenuProduct p).idealUnit I.carrier).val)
    (M : AlgebraicProjectiveData ι A) :
    ¬ ∀ w, M.probability w =
      P.canonicalTraceOfFormallyReal (P.formallyReal_of_associative_inner hinner)
        (P.sequentialBranchState p ρ w) := by
  intro hmatch
  let hfr := P.formallyReal_of_associative_inner hinner
  let f := P.canonicalPairingFunctional hfr ρ
  let fB := f.comp (P.generatedMenuCarrier p).subtype
  have hpos (x : P.generatedMenuCarrier p) :
      0 ≤ fB ((P.generatedMenuProduct p).product x x) := by
    have hdual := (P.canonicalTraceRepresentative_positive_iff hfr f).mp (by
      rw [P.canonicalTraceRepresentative_pairingFunctional]
      exact hρ.1)
    exact hdual x.val
  apply I.no_algebraicModel_of_positive_weight_of_primitiveTests
    (P.generatedMenuProduct_inner p hinner) (P.generatedMenuTest p) hp
    (P.generatedMenuProduct_generates p) fB hpos hweight M
  intro w
  change M.probability w =
    f (((P.generatedMenuProduct p).sequentialWordEffect (P.generatedMenuTest p) w).val)
  rw [P.generatedMenu_sequentialWordEffect p, hmatch, P.canonicalTrace_sequentialBranchState]

/-- The real and complex Hilbert-space cases of core Theorem 4.11(b), with
arbitrary Hilbert dimension, projection rank and representation state. -/
theorem no_hilbertModel_of_BPrimitiveMenu_albertWeight
    {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
    [CompleteSpace H]
    (hinner : ∀ x y z, inner ℝ (P.product x y) z = inner ℝ x (P.product y z))
    (hp : P.IsBPrimitiveMenu p)
    (I : (P.generatedMenuProduct p).AlbertIdeal)
    (ρ : E) (hρ : P.IsCanonicalDensity (P.formallyReal_of_associative_inner hinner) ρ)
    (hweight : 0 < P.canonicalTraceFormOfFormallyReal (P.formallyReal_of_associative_inner hinner) ρ
      ((P.generatedMenuProduct p).idealUnit I.carrier).val)
    (M : HilbertProjectiveData ι 𝕜 H) :
    ¬ ∀ w, M.probability w =
      P.canonicalTraceOfFormallyReal (P.formallyReal_of_associative_inner hinner)
        (P.sequentialBranchState p ρ w) := by
  intro hmatch
  apply P.no_algebraicModel_of_BPrimitiveMenu_albertWeight p hinner hp I ρ hρ hweight M.toAlgebraic
  intro w
  rw [M.toAlgebraic_probability]
  exact hmatch w

/-- The right-quaternionic Hilbert-space case of core Theorem 4.11(b). -/
theorem no_quaternionicModel_of_BPrimitiveMenu_albertWeight
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Q : QuaternionicOperatorStructure H)
    (hinner : ∀ x y z, inner ℝ (P.product x y) z = inner ℝ x (P.product y z))
    (hp : P.IsBPrimitiveMenu p)
    (I : (P.generatedMenuProduct p).AlbertIdeal)
    (ρ : E) (hρ : P.IsCanonicalDensity (P.formallyReal_of_associative_inner hinner) ρ)
    (hweight : 0 < P.canonicalTraceFormOfFormallyReal (P.formallyReal_of_associative_inner hinner) ρ
      ((P.generatedMenuProduct p).idealUnit I.carrier).val)
    (M : QuaternionicProjectiveData ι Q) :
    ¬ ∀ w, M.state (M.wordEffect w) =
      P.canonicalTraceOfFormallyReal (P.formallyReal_of_associative_inner hinner)
        (P.sequentialBranchState p ρ w) := by
  intro hmatch
  apply P.no_algebraicModel_of_BPrimitiveMenu_albertWeight p hinner hp I ρ hρ hweight M.toAlgebraic
  intro w
  rw [M.toAlgebraic_probability]
  exact hmatch w

end AlbertSequential.UnitalJordanProduct
